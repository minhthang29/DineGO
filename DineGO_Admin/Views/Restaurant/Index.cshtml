@model Core.Common.PaginatedList<Core.Models.Restaurant>

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Restaurant";
    ViewData["PaginationAction"] = "Index";
    ViewData["PaginationController"] = "Restaurant";
}

<h2 class="text-2xl font-bold mb-6">Quản lý Nhà Hàng</h2>
<div class="mb-4">
    <a href="@Url.Action("AddRestaurant", "Restaurant")" class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        <i class="fas fa-plus"></i> Thêm Nhà Hàng
    </a>
</div>
<div class="overflow-x-auto shadow-lg rounded-lg">
    <table class="bg-white dark:bg-gray-800">
        <thead class="bg-indigo-600 text-white">
            <tr>
                <th class="px-6 py-3 border-r border-indigo-200 text-left">ID</th>
                <th class="px-6 py-3 border-r resizable-col border-indigo-200 text-left">Tên nhà hàng</th>
                <th class="px-6 py-3 border-r resizable-col border-indigo-200 text-left">Email</th>
                <th class="px-6 py-3 border-r resizable-col border-indigo-200 text-left">Số điện thoại</th>
                <th class="px-6 py-3 border-r resizable-col border-indigo-200 text-left">Địa chỉ</th>
                <th class="px-6 py-3 border-r border-indigo-200 text-left">Giảm giá</th>
                <th class="px-6 py-3 border-r border-indigo-200 text-left">Đánh giá</th>
                <th class="px-6 py-3 border-r resizable-col border-indigo-200 text-left">Danh mục</th>
                <th class="px-6 py-3 border-r border-indigo-200 text-left">Hành động</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            @foreach (var restaurant in Model.Items)
            {
                <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                    <td class="px-6 py-4 truncate border-r border-indigo-200">@restaurant.res_id</td>
                    <td class="px-6 py-4 font-semibold truncate border-r border-indigo-200">
                        @if (restaurant.res_is_use)
                        {
                            <a href="@Url.Action("ViewDetail", "Restaurant", new { id = restaurant.res_id })"
                            class="text-blue-700 hover:underline">
                                @restaurant.res_name
                            </a>
                        }   
                        else
                        {
                            <span class="text-gray-400 flex items-center gap-1" title="Nhà hàng đã bị ngừng hoạt động">
                                <i class="fas fa-exclamation-triangle text-red-500"></i>
                                @restaurant.res_name
                            </span>
                        }
                    </td>
                    <td class="px-6 py-4 truncate border-r border-indigo-200">@restaurant.res_email</td>
                    <td class="px-6 py-4 truncate border-r border-indigo-200">@restaurant.res_phone</td>
                    <td class="px-6 py-4 truncate border-r border-indigo-200">@restaurant.res_address</td>
                    <td class="px-6 py-4 truncate text-red-600 border-r border-indigo-200">
                        @(restaurant.res_discount_promotion.HasValue ? $"{restaurant.res_discount_promotion.Value}%" : "0%")
                    </td>
                    <td class="px-6 py-4 truncate border-r border-indigo-200">
                        @(restaurant.res_rate.HasValue ? $"{restaurant.res_rate.Value:F1} ⭐" : "Chưa có")
                    </td>
                    <td class="px-6 py-4 truncate border-r border-indigo-200">
                        @(restaurant.category != null ? restaurant.category.cate_type : "")
                    </td>
                    <td class="px-6 py-4 relative">
                        <div class="flex justify-center">
                            <button type="button"
                                class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-200 dark:hover:bg-gray-700"
                                onclick="toggleActionMenu(this)">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <div class="absolute right-0 z-20 bg-white dark:bg-gray-800 border border-gray-300 rounded shadow-lg min-w-[140px] hidden action-menu">
                                <a href="@Url.Action("UpdateRestaurant", "Restaurant", new { id = restaurant.res_id })"
                                    class="block px-4 py-2 text-blue-600 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-blue-800">
                                    <i class="fas fa-edit mr-2"></i> Sửa
                                </a>
                                @if(restaurant.res_is_use)
                                {
                                    <button type="button"
                                        class="w-full text-left px-4 py-2 text-yellow-600 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-yellow-800"
                                        onclick="openBlockPopup(@restaurant.res_id)">
                                        <i class="fas fa-ban mr-2"></i> Chặn
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                        class="w-full text-left px-4 py-2 text-green-600 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-green-800"
                                        onclick="openActivatePopup(@restaurant.res_id)">
                                        <i class="fas fa-unlock-alt mr-2"></i> Kích hoạt
                                    </button>
                                }
                                <button type="button"
                                    class="w-full text-left px-4 py-2 text-red-600 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-red-800"
                                    onclick="deleteRestaurant(@restaurant.res_id)">
                                    <i class="fas fa-trash-alt"></i> Xóa
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", Model)

<!-- Block Popup Modal -->
<div id="block-popup"
     class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-6">
        <h3 class="text-xl font-bold mb-4 text-yellow-700 flex items-center gap-2">
            <i class="fas fa-ban"></i> Block Nhà Hàng
        </h3>
        <form id="block-form" method="post" action="/Restaurant/BlockRestaurant">
            <input type="hidden" name="id" id="block-id"/>
            <div class="mb-4">
                <label class="block font-semibold mb-1 text-black">Loại block</label>
                <select name="block_type" class="w-full border rounded px-3 py-2 text-black" required>
                    <option value="">Chọn loại block</option>
                    <option value="tam_thoi">Tạm thời</option>
                    <option value="vinh_vien">Vĩnh viễn</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block font-semibold mb-1 text-black">Loại vi phạm</label>
                <select name="violation_type" class="w-full border rounded px-3 py-2 text-black" required>
                    <option value="">Chọn loại vi phạm</option>
                    <option value="vi_pham_chinh_sach">Vi phạm chính sách</option>
                    <option value="noi_dung_spam">Nội dung spam</option>
                    <option value="sai_quy_dinh">Sai quy định</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block font-semibold mb-1 text-black">Nội dung block</label>
                <textarea name="block_reason" rows="3" class="w-full border rounded px-3 py-2 text-black" placeholder="Nhập lý do block..." required></textarea>
            </div>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeBlockPopup()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 text-black">Hủy</button>
                <button type="submit" class="px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700">Block</button>
            </div>
        </form>
    </div>
</div>

<!-- Activate Popup Modal -->
<div id="activate-popup"
     class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-6">
        <h3 class="text-xl font-bold mb-4 text-green-700 flex items-center gap-2">
            <i class="fas fa-unlock-alt"></i> Kích Hoạt Nhà Hàng
        </h3>
        <form id="activate-form" method="post" action="/Restaurant/ActiveRestaurant">
            <input type="hidden" name="id" id="activate-id"/>
            <div class="mb-4">
                <p class="text-gray-700">Bạn có chắc chắn muốn kích hoạt lại nhà hàng này không?</p>
                <p class="text-sm text-gray-500 mt-2">Nhà hàng sẽ được hiển thị trở lại và có thể hoạt động bình thường.</p>
            </div>
            <div class="mb-4">
                <label class="block font-semibold mb-1 text-black">Ghi chú (tùy chọn)</label>
                <textarea name="activate_note" rows="2" class="w-full border rounded px-3 py-2 text-black" placeholder="Nhập ghi chú về việc kích hoạt..."></textarea>
            </div>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeActivatePopup()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 text-black">Hủy</button>
                <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Kích Hoạt</button>
            </div>
        </form>
    </div>
</div>

<script>
// Block popup functions
function openBlockPopup(id) {
    document.getElementById('block-id').value = id;
    document.getElementById('block-popup').classList.remove('hidden');
}

function closeBlockPopup() {
    document.getElementById('block-popup').classList.add('hidden');
}

// Activate popup functions
function openActivatePopup(id) {
    document.getElementById('activate-id').value = id;
    document.getElementById('activate-popup').classList.remove('hidden');
}

function closeActivatePopup() {
    document.getElementById('activate-popup').classList.add('hidden');
}

// Delete function
function deleteRestaurant(id) {
    if (confirm('Bạn có chắc chắn muốn xóa nhà hàng này?')) {
        const form = document.createElement('form');
        form.method = 'post';
        form.action = '/Restaurant/DeleteRestaurant';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'id';
        input.value = id;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    }
}

// Toggle action menu
function toggleActionMenu(button) {
    const menu = button.nextElementSibling;
    const allMenus = document.querySelectorAll('.action-menu');
    
    // Close all other menus
    allMenus.forEach(m => {
        if (m !== menu) {
            m.classList.add('hidden');
        }
    });
    
    // Toggle current menu
    menu.classList.toggle('hidden');
}

// Close menus when clicking outside
document.addEventListener('click', function(event) {
    if (!event.target.closest('.relative')) {
        document.querySelectorAll('.action-menu').forEach(menu => {
            menu.classList.add('hidden');
        });
    }
});

// Close popups when pressing Escape
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeBlockPopup();
        closeActivatePopup();
    }
});
</script>