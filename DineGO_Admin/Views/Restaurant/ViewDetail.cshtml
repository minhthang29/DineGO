@model Core.Models.AdminModel.RestaurantViewDetailModel

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chi tiết nhà hàng";
}

<h2 class="text-2xl font-bold mb-6">Chi tiết nhà hàng</h2>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-8 max-w-2xl mx-auto">
    <!-- Thông tin cố định -->
    <div class="flex gap-6 items-center mb-6">
        <img src="@(string.IsNullOrEmpty(Model.Restaurant.res_images) ? Url.Content("~/images/logo.jpg") : Model.Restaurant.res_images)"
             alt="Restaurant Image" class="w-32 h-32 rounded object-cover border-2 border-indigo-400">
        <div>
            <h3 class="text-xl font-bold mb-2">@Model.Restaurant.res_name</h3>
            <div class="text-gray-600 dark:text-gray-300">ID: @Model.Restaurant.res_id</div>
            <div class="text-gray-600 dark:text-gray-300">Danh mục: @(Model.Restaurant.category?.cate_type ?? "")</div>
        </div>
    </div>
    <!-- Tabs nằm dưới phần thông tin cố định -->
    <div>
        <ul class="flex border-b mb-6" id="restaurant-tabs">
            <li>
                <button class="tab-btn px-4 py-2 -mb-px border-b-2 border-indigo-600 text-indigo-700 font-semibold focus:outline-none" onclick="showTab(this, 'info')">Thông Tin</button>
            </li>
            <li>
                <button class="tab-btn px-4 py-2 -mb-px border-b-2 border-indigo-600 text-indigo-700 font-semibold focus:outline-none" onclick="showTab(this, 'menu')">Menu</button>
            </li>
            <li>
                <button class="tab-btn px-4 py-2 -mb-px border-b-2 border-indigo-600 text-indigo-700 font-semibold focus:outline-none" onclick="showTab(this, 'orders')">Đơn hàng</button>
            </li>
            <li>
                <button class="tab-btn px-4 py-2 -mb-px border-b-2 border-indigo-600 text-indigo-700 font-semibold focus:outline-none" onclick="showTab(this, 'reviews')">Đánh giá</button>
            </li>
        </ul>
    </div>
    <!-- Tab Content -->
    <div id="tab-info" class="tab-content">
        <div class="mb-2"><strong>Chủ nhà hàng:</strong> @(Model.Restaurant.restaurantOwner != null ? Model.Restaurant.restaurantOwner.res_owner_name : "Không có")</div>
        <div class="mb-2"><strong>Email:</strong> @Model.Restaurant.res_email</div>
        <div class="mb-2"><strong>Số điện thoại:</strong> @Model.Restaurant.res_phone</div>
        <div class="mb-2"><strong>Địa chỉ:</strong> @Model.Restaurant.res_address</div>
        <div class="mb-2"><strong>Giảm giá:</strong> @(Model.Restaurant.res_discount_promotion.HasValue ? $"{Model.Restaurant.res_discount_promotion.Value}%" : "0%")</div>
        <div class="mb-2"><strong>Đánh giá:</strong> @(Model.Restaurant.res_rate.HasValue ? $"{Model.Restaurant.res_rate.Value:F1} ⭐" : "Chưa có")</div>
        <div class="mb-2"><strong>Mô tả:</strong> @Model.Restaurant.res_description</div>
        <div class="mt-6">
            <a href="@Url.Action("Index", "Restaurant")" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 text-black">Quay lại</a>
        </div>
    </div>
        <!-- Tab Menu: Danh sách menu và món ăn -->
    <div id="tab-menu" class="tab-content hidden">
        <h4 class="text-lg font-bold mb-2">Menu nhà hàng</h4>
        <div class="mb-4">
            @if (Model.Menus != null && Model.Menus.Any())
            {
                foreach (var menu in Model.Menus)
                {
                    <div class="bg-gray-100 rounded p-3 mb-2">
                        <div class="font-semibold text-indigo-700">Menu: @menu.menu_name</div>
                        <ul class="list-decimal ml-6 mt-1">
                            @if (menu.foods != null && menu.foods.Any())
                            {
                                var stt = 1;
                                foreach (var food in menu.foods)
                                {
                                    <li>
                                        <span class="font-semibold text-black">#@stt:</span>
                                        <span class="ml-2 text-black"><b>@food.food_name</b> - <b>@food.food_price.ToString("N0")</b>đ</span>
                                    </li>
                                    stt++;
                                }
                            }
                            else
                            {
                                <li class="text-black">Chưa có món ăn nào</li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="text-gray-500">Chưa có menu nào.</div>
            }
        </div>
    </div>

    <!-- Tab Orders: Danh sách đơn hàng -->
    <div id="tab-orders" class="tab-content hidden">
        <h4 class="text-lg font-bold mb-2">Danh sách đơn hàng</h4>
        <table class="w-full border rounded mb-4">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-3 py-2">Mã đơn</th>
                    <th class="px-3 py-2">Khách hàng</th>
                    <th class="px-3 py-2">Ngày đặt</th>
                    <th class="px-3 py-2">Tổng tiền</th>
                    <th class="px-3 py-2">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="px-3 py-2">DH001</td>
                    <td class="px-3 py-2">Nguyễn Văn A</td>
                    <td class="px-3 py-2">2025-07-15</td>
                    <td class="px-3 py-2">320.000đ</td>
                    <td class="px-3 py-2 text-green-600">Đã giao</td>
                </tr>
                <tr>
                    <td class="px-3 py-2">DH002</td>
                    <td class="px-3 py-2">Trần Thị B</td>
                    <td class="px-3 py-2">2025-07-14</td>
                    <td class="px-3 py-2">150.000đ</td>
                    <td class="px-3 py-2 text-yellow-600">Đang xử lý</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Tab Reviews: Danh sách đánh giá -->
    <div id="tab-reviews" class="tab-content hidden">
        <h4 class="text-lg font-bold mb-2">Đánh giá của khách hàng</h4>
        <div class="mb-4">
            <div class="border-b pb-3 mb-3">
                <div class="flex items-center gap-2">
                    <span class="font-semibold text-indigo-700">Nguyễn Văn A</span>
                    <span class="text-yellow-500">★★★★★</span>
                    <span class="text-gray-500 text-sm">2025-07-10</span>
                </div>
                <div class="mt-1 text-gray-700">Món ăn ngon, phục vụ nhiệt tình!</div>
            </div>
            <div class="border-b pb-3 mb-3">
                <div class="flex items-center gap-2">
                    <span class="font-semibold text-indigo-700">Trần Thị B</span>
                    <span class="text-yellow-500">★★★★☆</span>
                    <span class="text-gray-500 text-sm">2025-07-08</span>
                </div>
                <div class="mt-1 text-gray-700">Không gian sạch sẽ, giá hợp lý.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(btn, tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tab).classList.remove('hidden');
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('border-indigo-600', 'text-indigo-700', 'font-semibold'));
            btn.classList.add('border-indigo-600', 'text-indigo-700', 'font-semibold');
        }
        document.addEventListener('DOMContentLoaded', function () {
            showTab(document.querySelector('.tab-btn'), 'info');
        });
    </script>
}