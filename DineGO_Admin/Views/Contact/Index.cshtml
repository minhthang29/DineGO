@model List<Core.Models.Contact>
@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Liên hệ";
}
<h2 class="text-2xl font-bold mb-6">Danh sách Liên hệ</h2>
<div class="overflow-x-auto shadow-lg rounded-lg">
    <table class="min-w-full bg-white dark:bg-gray-800">
        <thead class="bg-indigo-600 text-white">
            <tr>
                <th class="px-3 py-2 text-left">ID</th>
                <th class="px-3 py-2 text-left">Họ tên</th>
                <th class="px-3 py-2 text-left">Email</th>
                <th class="px-3 py-2 text-left">Tiêu đề</th>
                <th class="px-3 py-2 text-left">Nội dung</th>
                <th class="px-3 py-2 text-left">Trạng thái</th>
                <th class="px-3 py-2 text-left">Admin trả lời</th>
                <th class="px-3 py-2 text-left">Nội dung trả lời</th>
                <th class="px-3 py-2 text-left">Ngày gửi</th>
                <th class="px-3 py-2 text-left">Ngày trả lời</th>
                <th class="px-3 py-2 text-left">Hành động</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            @if (Model != null && Model.Any())
            {
                foreach (var c in Model)
                {
                    <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                        <td class="px-3 py-2">@c.contact_id</td>
                        <td class="px-3 py-2">@c.contact_name</td>
                        <td class="px-3 py-2">@c.contact_email</td>
                        <td class="px-3 py-2">@c.contact_subject</td>
                        <td class="px-3 py-2">@c.contact_message</td>
                        <td class="px-3 py-2">@c.contact_status</td>
                        <td class="px-3 py-2">@c.contact_reply_by_admin</td>
                        <td class="px-3 py-2">@c.contact_reply_message</td>
                        <td class="px-3 py-2">@c.contact_created_at.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-3 py-2">@c.contact_replied_at?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-3 py-2">
                            <div class="flex space-x-3 text-lg">
                                <a href="@Url.Action("Edit", "Contact", new { id = c.contact_id })" class="text-blue-600 hover:text-blue-800">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="@Url.Action("Delete", "Contact", new { id = c.contact_id })" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa liên hệ này?');" class="inline">
                                    <button type="submit" class="text-red-600 hover:text-red-800">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center py-4 text-gray-500">Không có liên hệ nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>