@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Xóa Danh Mục";
}

<div class="max-w-xl mx-auto mt-8 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8">
    <h2 class="text-2xl font-bold mb-6 text-red-600">@ViewData["Title"]</h2>

    <form method="post" asp-action="DeleteCategory" asp-controller="Category" class="space-y-6">
        <input type="hidden" name="cate_id" value="@Model.cate_id" />

        <div>
            <label class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Mã Danh Mục</label>
            <input type="text" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500 cursor-not-allowed" value="@Model.cate_id" readonly>
        </div>

        <div>
            <label class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Loại Danh Mục</label>
            <input type="text" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500 cursor-not-allowed" value="@Model.cate_type" readonly>
        </div>

        <div>
            <label class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Mô Tả</label>
            <textarea class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500 cursor-not-allowed" rows="3" readonly>@Model.cate_description</textarea>
        </div>

        <div class="flex justify-between mt-6">
            <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded hover:bg-red-700 font-semibold transition">
                Xóa Danh Mục
            </button>
            <a href="@Url.Action("Index")" class="px-6 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 font-semibold transition">
                Quay lại
            </a>
        </div>
    </form>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}