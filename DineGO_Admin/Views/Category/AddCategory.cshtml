@{
    ViewData["Title"] = "Thêm Danh Mục";
    Layout = "../../Views/Shared/_Layout.cshtml";
}

<div class="max-w-xl mx-auto mt-8 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8">
    <h2 class="text-2xl font-bold mb-6 text-indigo-700">Thêm Danh Mục Mới</h2>

    <form asp-action="AddCategory" method="post" class="space-y-6">
        <div>
            <label for="cate_type" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Loại Danh Mục *</label>
            <input type="text" id="cate_type" name="cate_type" required
                   class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500" />
        </div>

        <div>
            <label for="cate_description" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Mô Tả</label>
            <textarea id="cate_description" name="cate_description" rows="3"
                      class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500"></textarea>
        </div>

        <div class="flex justify-between mt-6">
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-semibold transition">
                Thêm
            </button>
            <a href="@Url.Action("Index")" class="px-6 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 font-semibold transition">
                Hủy
            </a>
        </div>
    </form>
</div>