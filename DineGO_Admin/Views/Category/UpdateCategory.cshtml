@model Core.Models.Category
@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cập nhật danh mục";
}

<div class="max-w-xl mx-auto mt-8 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8">
    <h2 class="text-2xl font-bold mb-6 text-indigo-700">@ViewData["Title"]</h2>

    <form method="post" asp-action="UpdateCategory" asp-controller="Category" class="space-y-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded bg-green-100 text-green-800 font-semibold">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded bg-red-100 text-red-800 font-semibold">
                @TempData["ErrorMessage"]
            </div>
        }

        <div>
            <label for="category-id" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Mã danh mục</label>
            <input type="text" id="category-id" name="cate_id" value="@Model.cate_id" readonly
                   class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500 cursor-not-allowed" />
        </div>

        <div>
            <label for="category-type" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Loại danh mục *</label>
           <input type="text" id="category-type" name="cate_type" value="@Model.cate_type" required
       class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500" />
            <span asp-validation-for="cate_type" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label for="category-description" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Mô tả</label>
           <textarea id="category-description" name="cate_description" rows="3"
          class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-500">@Model.cate_description</textarea>
            <span asp-validation-for="cate_description" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex justify-between mt-6">
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-semibold transition">
                Cập nhật danh mục
            </button>
            <a href="@Url.Action("Index")" class="px-6 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 font-semibold transition">
                Quay lại
            </a>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}