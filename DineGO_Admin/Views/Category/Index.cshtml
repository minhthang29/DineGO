@model List<Core.Models.Category>

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Category";
}
<h2 class="text-2xl font-bold mb-6">Quản lý Danh Mục</h2>
<div class="mb-4">
    <a href="@Url.Action("AddCategory", "Category")" class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        <i class="fas fa-plus"></i> Thêm Danh Mục
    </a>
</div>
<div class="overflow-x-auto shadow-lg rounded-lg">
    <table class="min-w-full bg-white dark:bg-gray-800">
        <thead class="bg-indigo-600 text-white">
            <tr>
                <th class="px-6 py-3 text-left">ID</th>
                <th class="px-6 py-3 text-left">Loại</th>
                <th class="px-6 py-3 text-left">Mô tả</th>
                <th class="px-6 py-3 text-left">Hành động</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            @foreach (var category in Model)
            {
                <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                    <td class="px-6 py-4 font-semibold">@category.cate_id</td>
                    <td class="px-6 py-4 font-semibold">@category.cate_type</td>
                    <td class="px-6 py-4">@category.cate_description</td>
                    <td class="px-6 py-4">
                        <div class="flex space-x-3 text-lg">
                            <a href="@Url.Action("UpdateCategory", "Category", new { id = category.cate_id })" class="text-blue-600 hover:text-blue-800">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("DeleteCategory", "Category", new { id = category.cate_id })" class="text-red-600 hover:text-red-800">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>