@model Core.Models.Customer
@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Xóa Khách Hàng";
}

<div class="max-w-xl mx-auto mt-8 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8">
    <h2 class="text-2xl font-bold mb-6 text-red-600">@ViewData["Title"]</h2>

    <form asp-action="DeleteCustomer" method="post" class="space-y-6">
        <input type="hidden" name="id" value="@Model.cus_id" />

        <div>
            <label class="block mb-1 font-medium text-gray-700 dark:text-gray-200">ID</label>
            <input type="text" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900 cursor-not-allowed" value="@Model.cus_id" readonly />
        </div>
        <div>
            <label class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Username</label>
            <input type="text" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900 cursor-not-allowed" value="@Model.cus_username" readonly />
        </div>
        <div>
            <label class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Name</label>
            <input type="text" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900 cursor-not-allowed" value="@Model.cus_name" readonly />
        </div>
        <div>
            <label class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Email</label>
            <input type="email" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900 cursor-not-allowed" value="@Model.cus_email" readonly />
        </div>
        <div class="flex justify-between mt-6">
            <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded hover:bg-red-700 font-semibold transition">
                Xóa khách hàng
            </button>
            <a href="javascript:history.back()" class="px-6 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 font-semibold transition">
                Quay lại
            </a>
        </div>
    </form>
</div>