@model Core.Models.Customer
@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thêm Khách Hàng";
}

<div class="max-w-xl mx-auto mt-8 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8">
    <h2 class="text-2xl font-bold mb-6 text-indigo-700">Thêm Khách Hàng Mới</h2>


    <form asp-action="AddCustomer" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.ValidationSummary(true, "", new { @class = "text-red-500 mb-4" })
        <div class="flex flex-col items-center mb-4">
            <img id="avatar-preview"
                 src="https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/customers/thumb_default.jpeg"
                 alt="Avatar"
                 class="w-24 h-24 rounded-full object-cover border-2 border-indigo-400 mb-2" />
            <input type="file" id="cus_image" name="cus_image" accept="image/*"
                   class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" />
        </div>
        <div>
            <label for="cus_username" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Tên đăng nhập *</label>
            <input type="text" id="cus_username" name="cus_username" value="@Model.cus_username" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900" required/>
        </div>
        <div>
            <label for="cus_password" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Mật khẩu *</label>
            <input type="password" id="cus_password" name="cus_password" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900" required />
        </div>
        <div>
            <label for="cus_confirm_password" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Xác nhận mật khẩu *</label>
            <input type="password" id="cus_confirm_password" name="cus_confirm_password" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900" required />
            <span id="password-match-message" class="text-red-500 text-sm"></span>
        </div>
        <div>
            <label for="cus_name" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Họ tên *</label>
            <input type="text" id="cus_name" name="cus_name" value="@Model.cus_name" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900" required />
        </div>
        <div>
            <label for="cus_email" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Email *</label>
            <input type="email" id="cus_email" name="cus_email" value="@Model.cus_email" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900" required />
        </div>
        <div>
            <label for="cus_phone" class="block mb-1 font-medium text-gray-700 dark:text-gray-200">Số điện thoại *</label>
            <input type="text" id="cus_phone" name="cus_phone" value="@Model.cus_phone" class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-900" required />
        </div>
        <div class="flex justify-between mt-6">
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-semibold transition">
                Thêm khách hàng
            </button>
            <a href="@Url.Action("Index")" class="px-6 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 font-semibold transition">
                Hủy
            </a>
        </div>
    </form>
</div>

<script src="/js/customer.js"></script>