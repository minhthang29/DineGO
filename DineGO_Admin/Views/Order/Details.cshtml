@model Core.Models.Order
@using System.Text.Json;

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.order_id;
}

<div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <nav class="flex items-center space-x-2 text-sm text-gray-500 mb-4">
            <a href="@Url.Action("Index")" class="hover:text-blue-600">Đơn hàng</a>
            <i class="fas fa-chevron-right"></i>
            <span>Chi tiết đơn #@Model.order_id</span>
        </nav>
        
        <div class="flex justify-between items-center">
            <h1 class="text-3xl font-bold text-gray-900">Chi tiết đơn hàng #@Model.order_id</h1>
            
            <!-- Status Badge -->
            @{
                string statusText = Model.order_status switch
                {
                    0 => "Chờ xác nhận",
                    1 => "Đã xác nhận",
                    2 => "Đang giao",
                    3 => "Hoàn thành",
                    4 => "Đã hủy",
                    _ => "Không xác định"
                };
                string statusColor = Model.order_status switch
                {
                    0 => "bg-yellow-100 text-yellow-800 border-yellow-300",
                    1 => "bg-blue-100 text-blue-800 border-blue-300",
                    2 => "bg-indigo-100 text-indigo-800 border-indigo-300",
                    3 => "bg-green-100 text-green-800 border-green-300",
                    4 => "bg-red-100 text-red-800 border-red-300",
                    _ => "bg-gray-100 text-gray-800 border-gray-300"
                };
            }
            <span class="px-4 py-2 rounded-full font-semibold border @statusColor">@statusText</span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Order Information -->
        <div class="lg:col-span-2">
            <!-- Order Items -->
            <div class="bg-white rounded-lg shadow p-6 mb-6">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Món đã đặt</h3>
                
                @if (Model.orderDetails != null && Model.orderDetails.Any())
                {
                    <div class="space-y-4">
                        @foreach (var item in Model.orderDetails)
                        {
                            <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg">
                                @if (!string.IsNullOrEmpty(item.FirstImage))
                                {
                                    <img src="@item.FirstImage" alt="@item.food_name_snapshot" 
                                         class="w-16 h-16 rounded-lg object-cover">
                                }
                                else
                                {
                                    <div class="w-16 h-16 bg-gray-200 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-utensils text-gray-400"></i>
                                    </div>
                                }
                                
                                <div class="flex-1">
                                    <h4 class="font-semibold text-gray-900">@(item.food_name_snapshot ?? "Món ăn không xác định")</h4>
                                    <p class="text-sm text-gray-600">@(item.food_description_snapshot ?? "")</p>
                                    <div class="flex items-center space-x-4 mt-2">
                                        <span class="text-sm text-gray-500">Số lượng: <strong>@item.order_quantity</strong></span>
                                        <span class="text-sm text-gray-500">Đơn giá: <strong>@item.order_price.ToString("N0") VNĐ</strong></span>
                                    </div>
                                </div>
                                
                                <div class="text-right">
                                    <p class="text-lg font-bold text-green-600">
                                        @((item.order_price * item.order_quantity).ToString("N0")) VNĐ
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <i class="fas fa-shopping-cart text-gray-300 text-4xl mb-4"></i>
                        <p class="text-gray-500">Không có thông tin chi tiết món ăn</p>
                    </div>
                }
            </div>

            <!-- Order Timeline -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Lịch sử đơn hàng</h3>
                <div class="space-y-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                            <i class="fas fa-plus text-white text-xs"></i>
                        </div>
                        <div>
                            <p class="font-medium text-gray-900">Đơn hàng được tạo</p>
                            <p class="text-sm text-gray-500">@Model.order_date.ToString("dd/MM/yyyy HH:mm:ss")</p>
                        </div>
                    </div>
                    
                    @if (Model.estimated_delivery_time.HasValue)
                    {
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-clock text-white text-xs"></i>
                            </div>
                            <div>
                                <p class="font-medium">Thời gian giao hàng dự kiến</p>
                                <p class="text-sm text-gray-500">@Model.estimated_delivery_time.Value.ToString("dd/MM/yyyy HH:mm:ss")</p>
                            </div>
                        </div>
                    }
                    
                    @if (Model.order_status == 3)
                    {
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-white text-xs"></i>
                            </div>
                            <div>
                                <p class="font-medium">Đơn hàng hoàn thành</p>
                            </div>
                        </div>
                    }
                    
                    @if (Model.order_status == 4)
                    {
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-red-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-times text-white text-xs"></i>
                            </div>
                            <div>
                                <p class="font-medium">Đơn hàng đã bị hủy</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Customer Info -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Thông tin khách hàng</h3>
                <div class="space-y-3  text-gray-900">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold">
                            @{
                                var customerName = Model.customer_name_snapshot ?? Model.customer?.cus_name ?? "U";
                            }
                            @customerName.FirstOrDefault().ToString().ToUpper()
                        </div>
                        <div>
                            <p class="font-medium">@(customerName)</p>
                            <p class="text-sm text-gray-500">@(Model.customer?.cus_email ?? "")</p>
                        </div>
                    </div>
                    
                    @{
                        var customerPhone = Model.customer_phone_snapshot ?? Model.customer?.cus_phone;
                    }
                    @if (!string.IsNullOrEmpty(customerPhone))
                    {
                        <div class="flex items-center space-x-2">
                            <i class="fas fa-phone text-gray-400"></i>
                            <span class="text-sm">@customerPhone</span>
                        </div>
                    }
                    
                    @{
                        var deliveryAddress = Model.delivery_address_snapshot ?? Model.customer?.cus_address;
                    }
                    @if (!string.IsNullOrEmpty(deliveryAddress))
                    {
                        <div class="flex items-start space-x-2">
                            <i class="fas fa-map-marker-alt text-gray-400 mt-1"></i>
                            <span class="text-sm">@deliveryAddress</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Restaurant Info -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Thông tin nhà hàng</h3>
                <div class="space-y-3 text-gray-900">
                    @if (!string.IsNullOrEmpty(Model.restaurant?.res_images))
                    {
                        try
                        {
                            var images = JsonSerializer.Deserialize<List<string>>(Model.restaurant.res_images);
                            if (images != null && images.Count > 0)
                            {
                                <img src="@images[0]" alt="@Model.restaurant.res_name" 
                                     class="w-full h-24 object-cover rounded-lg">
                            }
                        }
                        catch
                        {
                            // Fallback to single image if JSON parsing fails
                            @if (!string.IsNullOrEmpty(Model.restaurant?.res_images))
                            {
                                <img src="@Model.restaurant.res_images" alt="@Model.restaurant.res_name" 
                                     class="w-full h-24 object-cover rounded-lg">
                            }
                        }
                    }
                    else if (!string.IsNullOrEmpty(Model.restaurant?.res_images))
                    {
                        <img src="@Model.restaurant.res_images" alt="@Model.restaurant.res_name" 
                             class="w-full h-24 object-cover rounded-lg">
                    }
                    else
                    {
                        <div class="w-full h-24 bg-gray-200 rounded-lg flex items-center justify-center">
                            <i class="fas fa-store text-gray-400 text-2xl"></i>
                        </div>
                    }
                    
                    <div>
                        <p class="font-medium">@(Model.restaurant?.res_name ?? "Nhà hàng không xác định")</p>
                        <p class="text-sm text-gray-500">@(Model.restaurant?.res_description ?? "")</p>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.restaurant?.res_phone))
                    {
                        <div class="flex items-center space-x-2">
                            <i class="fas fa-phone text-gray-400"></i>
                            <span class="text-sm">@Model.restaurant.res_phone</span>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(Model.restaurant?.res_address))
                    {
                        <div class="flex items-start space-x-2">
                            <i class="fas fa-map-marker-alt text-gray-400 mt-1"></i>
                            <span class="text-sm">@Model.restaurant.res_address</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Summary -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Tổng kết đơn hàng</h3>
                <div class="space-y-3 text-gray-900">
                    <div class="flex justify-between">
                        <span>Tạm tính:</span>
                        <span>@Model.order_subtotal.ToString("N0") VNĐ</span>
                    </div>
                    
                    @if (Model.delivery_fee.HasValue && Model.delivery_fee > 0)
                    {
                        <div class="flex justify-between">
                            <span>Phí giao hàng:</span>
                            <span>@Model.delivery_fee.Value.ToString("N0") VNĐ</span>
                        </div>
                    }
                    
                    @if (Model.order_price_discount.HasValue && Model.order_price_discount > 0)
                    {
                        <div class="flex justify-between text-red-600">
                            <span>Giảm giá:</span>
                            <span>-@Model.order_price_discount.Value.ToString("N0") VNĐ</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.voucher_code_applied))
                        {
                            <div class="text-xs text-gray-500">
                                Mã: @Model.voucher_code_applied
                            </div>
                        }
                    }
                    
                    <hr>
                    <div class="flex justify-between text-lg font-bold">
                        <span>Tổng cộng:</span>
                        <span class="text-green-600">@Model.order_total.ToString("N0") VNĐ</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            @if (Model.order_status != 3 && Model.order_status != 4)
            {
                <div class="bg-white rounded-lg shadow p-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Cập nhật trạng thái</h3>
                    <form method="post" action="/Order/ChangeStatus">
                        <input type="hidden" name="orderId" value="@Model.order_id" />
                        <select name="newStatus" class="w-full border rounded-lg px-3 py-2 mb-4 text-gray-900">
                            <option value="0" @(Model.order_status == 0 ? "selected" : "")>Chờ xác nhận</option>
                            <option value="1" @(Model.order_status == 1 ? "selected" : "")>Đã xác nhận</option>
                            <option value="2" @(Model.order_status == 2 ? "selected" : "")>Đang giao</option>
                            <option value="3" @(Model.order_status == 3 ? "selected" : "")>Hoàn thành</option>
                            <option value="4" @(Model.order_status == 4 ? "selected" : "")>Đã hủy</option>
                        </select>
                        <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-save mr-2"></i>Cập nhật trạng thái
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="fixed top-4 right-4 z-50">
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-lg">
            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="fixed top-4 right-4 z-50">
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-lg">
            <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        </div>
    </div>
}

<script>
// Auto hide notifications after 3 seconds
setTimeout(() => {
    const notifications = document.querySelectorAll('.fixed.top-4.right-4');
    notifications.forEach(notification => {
        notification.style.opacity = '0';
        setTimeout(() => notification.remove(), 300);
    });
}, 3000);
</script>