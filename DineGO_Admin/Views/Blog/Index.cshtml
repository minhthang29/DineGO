@model List<Core.Models.Blog>

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Blog";
}
<h2 class="text-2xl font-bold mb-6">Quản lý Bài Viết</h2>
<div class="mb-4">
    <a href="@Url.Action("AddBlog", "Blog")" class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        <i class="fas fa-plus"></i> Thêm Bài Viết
    </a>
</div>
<div class="overflow-x-auto shadow-lg rounded-lg">
    <table class="bg-white dark:bg-gray-800">
        <thead class="bg-indigo-600 text-white">
            <tr>
                <th class="px-6 py-3 w-24 text-left border-r border-indigo-200">Hình ảnh</th>
                <th class="px-6 py-3 w-20 text-left border-r border-indigo-200">ID</th>
                <th class="px-6 py-3 w-56 text-left resizable-col border-r border-indigo-200">Tiêu đề
                    <span class="resizer"></span>
                </th>
                <th class="px-6 py-3 w-32 text-left border-r border-indigo-200">Ngày</th>
                <th class="px-6 py-3 w-72 text-left resizable-col border-r border-indigo-200">Nội dung
                    <span class="resizer"></span>
                </th>
                <th class="px-6 py-3 w-32 text-left border-r border-indigo-200">Hành động</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            @foreach (var blog in Model)
            {
                <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                    <td class="px-6 py-4 border-r border-gray-200">
                        <img src="@(string.IsNullOrEmpty(blog.blog_image) ? "https://images.unsplash.com/photo-1506748686214-e9df14d4d9d0" : "https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/blogs/thumb_" + blog.blog_image)"
                             alt="@blog.blog_title"
                             class="w-16 h-16 rounded object-cover border-2 border-indigo-400">
                    </td>
                    <td class="px-6 py-4 font-semibold border-r border-gray-200">@blog.blog_id</td>
                    <td class="px-6 py-4 truncate resizable-col border-r border-gray-200" title="@blog.blog_title">@blog.blog_title</td>
                    <td class="px-6 py-4 border-r border-gray-200">@blog.blog_date.ToString("yyyy-MM-dd")</td>
                    <td class="px-6 py-4 truncate resizable-col border-r border-gray-200" title="@blog.blog_information">@blog.blog_information</td>
                    <td class="px-6 py-4 border-r border-gray-200">
                        <div class="flex space-x-3 text-lg">
                            <a href="@Url.Action("UpdateBlog", "Blog", new { id = blog.blog_id })" class="text-blue-600 hover:text-blue-800">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="/Blog/DeleteBlog" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này?');" class="inline">
                                <input type="hidden" name="id" value="@blog.blog_id" />
                                <button type="submit" class="text-red-600 hover:text-red-800">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>