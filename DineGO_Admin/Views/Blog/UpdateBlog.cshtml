@model Core.Models.Blog
@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Blog";
}
<h2 class="text-2xl font-bold mb-2">Cập nhật Blog</h2>
<form asp-action="UpdateBlog" method="post" enctype="multipart/form-data" class="bg-white dark:bg-gray-800 shadow rounded-lg p-8 max-w-xl mx-auto">
<input name="blog_id" value="@Model.blog_id" hidden />
    <div class="mb-4">
        <label for="blog_title" class="block font-semibold mb-1 text-white">Tiêu đề</label>
        <input name="blog_title" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-black" placeholder="Nhập tiêu đề blog..." value="@Model.blog_title" />
    </div>
    <div class="mb-4">
        <label for="blog_image_file" class="block font-semibold mb-1 text-white">Ảnh thumbnail</label>
        <input name="blog_image_file" type="file" class="w-full border rounded px-3 py-2 bg-white text-black" value="@Model.blog_image"/>
        <small class="text-gray-600">Để trống nếu không muốn thêm ảnh.</small>
    </div>
    <div class="mb-4" style="position: relative;">
        <label for="blog_information" class="block font-semibold mb-1 text-white">Nội dung</label>
        <button type="button" id="toggle-fullscreen"
            style="position: absolute; top: -10px; right: 0; background: transparent; border: none; cursor: pointer; padding: 4px;"
            title="Phóng to">
            <i class="fas fa-expand text-indigo-400" style="font-size: 28px;"></i>
        </button>
        <textarea id="blog_information" name="blog_information" rows="8"
            class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-black">@Model.blog_information</textarea>
    </div>
    <div class="flex justify-between">
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-semibold">Cập nhật Blog</button>
        <a href="@Url.Action("Index")" class="px-6 py-2 bg-gray-300 text-black rounded hover:bg-gray-400 font-semibold">Quay lại</a>
    </div>
</form>

<!-- TinyMCE -->
<script src="https://cdn.tiny.cloud/1/i54gejcl87m6ahjnn1p306mtnqbjjt1qxscnftfl1rk2fixy/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    tinymce.init({
        selector: '#blog_information',
        height: 400,
        plugins: 'advlist autolink lists link image charmap preview anchor searchreplace visualblocks code fullscreen insertdatetime media table code help wordcount',
        toolbar: 'undo redo | formatselect | bold italic underline forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | removeformat | link image media | code fullscreen',
        menubar: 'file edit view insert format tools table help',
        branding: false,
        content_style: "body { font-family:Helvetica,Arial,sans-serif; font-size:16px }"
    });
    document.getElementById('toggle-fullscreen').onclick = function() {
        tinymce.activeEditor.execCommand('mceFullScreen');
    };
</script>