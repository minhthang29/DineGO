@model List<Core.Models.Reservation>

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reservation";
}

<h2 class="text-2xl font-bold mb-6">Quản lý Đơn Đặt Bàn</h2>

<!-- Filter and Stats -->
<div class="mb-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
        <div class="bg-white rounded-lg shadow p-4">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-calendar-check text-blue-500 text-2xl"></i>
                </div>
                <div class="ml-4">
                    <div class="text-sm font-medium text-gray-500">Tổng đặt bàn</div>
                    <div class="text-2xl font-bold text-gray-900">@Model.Count</div>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-clock text-yellow-500 text-2xl"></i>
                </div>
                <div class="ml-4">
                    <div class="text-sm font-medium text-gray-500">Chờ xác nhận</div>
                    <div class="text-2xl font-bold text-yellow-600">@Model.Count(r => r.reser_status == 0)</div>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-check-circle text-green-500 text-2xl"></i>
                </div>
                <div class="ml-4">
                    <div class="text-sm font-medium text-gray-500">Đã xác nhận</div>
                    <div class="text-2xl font-bold text-green-600">@Model.Count(r => r.reser_status == 1)</div>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-times-circle text-red-500 text-2xl"></i>
                </div>
                <div class="ml-4">
                    <div class="text-sm font-medium text-gray-500">Đã hủy</div>
                    <div class="text-2xl font-bold text-red-600">@Model.Count(r => r.reser_status == 2)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="overflow-x-auto shadow-lg rounded-lg">
    <table class="min-w-full bg-white dark:bg-gray-800">
        <thead class="bg-indigo-600 text-white">
            <tr>
                <th class="px-6 py-3 text-left">Mã Đặt Chỗ</th>
                <th class="px-6 py-3 text-left">Nhà Hàng</th>
                <th class="px-6 py-3 text-left">Khách Hàng</th>
                <th class="px-6 py-3 text-left">Số Điện Thoại</th>
                <th class="px-6 py-3 text-left">Bàn</th>
                <th class="px-6 py-3 text-left">Ngày & Giờ</th>
                <th class="px-6 py-3 text-left">Trạng Thái</th>
                <th class="px-6 py-3 text-left">Ghi Chú</th>
                <th class="px-6 py-3 text-left">Hành Động</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            @foreach (var reservation in Model.OrderByDescending(r => r.reser_create_at))
            {
                <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                    <td class="px-6 py-4 font-semibold">
                        <p>
                            #@reservation.reser_id
                        </p>
                    </td>
                    <td class="px-6 py-4">
                        <div>
                            <p class="font-medium">@(reservation.restaurant?.res_name ?? "Không xác định")</p>
                            <p class="text-sm text-gray-500">@(reservation.restaurant?.res_address ?? "")</p>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold">
                                @(reservation.customer?.cus_name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                            </div>
                            <div>
                                <p class="font-medium">@(reservation.customer?.cus_name ?? "Không xác định")</p>
                                <p class="text-sm text-gray-500">@(reservation.customer?.cus_email ?? "")</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="text-sm">@(reservation.customer?.cus_phone ?? "Không có")</span>
                    </td>
                    <td class="px-6 py-4">
                        <div>
                            <p class="font-medium">@(reservation.table?.table_name ?? "Không xác định")</p>
                            <p class="text-sm text-gray-500">@(reservation.table?.table_seat ?? 0) người</p>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <div>
                            <p class="font-medium">@reservation.reser_date.ToString("dd/MM/yyyy")</p>
                            <p class="text-sm text-gray-500">@reservation.reser_date.ToString("HH:mm")</p>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        @{
                            string statusText = reservation.reser_status switch
                            {
                                0 => "Chờ xác nhận",
                                1 => "Đã xác nhận",
                                2 => "Đã hủy",
                                3 => "Hoàn thành",
                                _ => "Không xác định"
                            };
                            string statusColor = reservation.reser_status switch
                            {
                                0 => "bg-yellow-100 text-yellow-800 border-yellow-300",
                                1 => "bg-blue-100 text-blue-800 border-blue-300",
                                2 => "bg-red-100 text-red-800 border-red-300",
                                3 => "bg-green-100 text-green-800 border-green-300",
                                _ => "bg-gray-100 text-gray-800 border-gray-300"
                            };
                        }
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold border @statusColor">@statusText</span>
                    </td>
                    <td class="px-6 py-4 max-w-xs">
                        <p class="text-sm text-gray-600 truncate" title="@reservation.reser_note">
                            @(string.IsNullOrEmpty(reservation.reser_note) ? "-" : reservation.reser_note)
                        </p>
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center space-x-2">
                            <!-- Status Update -->
                            @if (reservation.reser_status != 3 && reservation.reser_status != 2) // Not completed or cancelled
                            {
                                <form method="post" action="/Reservation/ChangeStatus" class="flex items-center space-x-2">
                                    <input type="hidden" name="reserId" value="@reservation.reser_id" />
                                    <select name="newStatus" class="border rounded px-2 py-1 text-xs min-w-0 flex-shrink-0"
                                            onchange="updateSelectColor(this)">
                                        <option value="0" @(reservation.reser_status == 0 ? "selected" : "")>Chờ xác nhận</option>
                                        <option value="1" @(reservation.reser_status == 1 ? "selected" : "")>Đã xác nhận</option>
                                        <option value="2" @(reservation.reser_status == 2 ? "selected" : "")>Đã hủy</option>
                                        <option value="3" @(reservation.reser_status == 3 ? "selected" : "")>Hoàn thành</option>
                                    </select>
                                    <button type="submit" class="px-2 py-1 bg-green-600 text-white rounded text-xs hover:bg-green-700 flex-shrink-0" 
                                            title="Cập nhật trạng thái">
                                        <i class="fas fa-save"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-gray-500 text-xs">@statusText</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Empty State -->
@if (!Model.Any())
{
    <div class="text-center py-12">
        <i class="fas fa-calendar-times text-gray-300 text-6xl mb-4"></i>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Chưa có đặt chỗ nào</h3>
        <p class="text-gray-500">Các đặt chỗ sẽ xuất hiện ở đây khi có khách hàng đặt bàn.</p>
    </div>
}
@section Scripts {
<script>
function updateSelectColor(select) {
    select.classList.remove(
        "bg-yellow-100", "text-yellow-800", "border-yellow-300",
        "bg-blue-100", "text-blue-800", "border-blue-300",
        "bg-red-100", "text-red-800", "border-red-300",
        "bg-green-100", "text-green-800", "border-green-300"
    );
    
    switch (select.value) {
        case "0":
            select.classList.add("bg-yellow-100", "text-yellow-800", "border-yellow-300");
            break;
        case "1":
            select.classList.add("bg-blue-100", "text-blue-800", "border-blue-300");
            break;
        case "2":
            select.classList.add("bg-red-100", "text-red-800", "border-red-300");
            break;
        case "3":
            select.classList.add("bg-green-100", "text-green-800", "border-green-300");
            break;
    }
}

// Auto hide notifications after 3 seconds
setTimeout(() => {
    const notifications = document.querySelectorAll('.fixed.top-4.right-4');
    notifications.forEach(notification => {
        notification.style.opacity = '0';
        setTimeout(() => notification.remove(), 300);
    });
}, 3000);

document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('select[name="newStatus"]').forEach(updateSelectColor);
});
</script>
}