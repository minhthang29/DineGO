@model List<Core.Models.Customer>
@{
    ViewData["Title"] = "Thêm Chủ Nhà Hàng";
    Layout = "../../Views/Shared/_Layout.cshtml";
}

<div class="max-w-xl mx-auto mt-8 bg-white dark:bg-gray-800 rounded-lg shadow p-8">
    <h2 class="text-2xl font-bold text-center mb-6">Thêm Chủ Nhà Hàng Mới</h2>
    <form asp-action="Create" method="post" class="space-y-5">
        <div>
            <label class="block font-semibold mb-1">Chọn khách hàng</label>
            <select name="cus_id" class="text-black w-full border rounded px-3 py-2 focus:outline-none focus:ring focus:border-indigo-500" required>
                <option value="">-- Chọn khách hàng --</option>
                @foreach (var cus in Model)
                {
                    <option value="@cus.cus_id">
                        @cus.cus_username (@cus.cus_name)
                    </option>
                }
            </select>
        </div>
        <div>
            <label class="block font-semibold mb-1">Tên chủ nhà hàng</label>
            <input type="text" name="res_owner_name" class="text-black w-full border rounded px-3 py-2 focus:outline-none focus:ring focus:border-indigo-500" required />
        </div>
        <div class="flex gap-3 mt-6">
            <button type="submit" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-semibold py-2 rounded transition">Thêm</button>
            <a href="@Url.Action("Index", "RestaurantOwner")" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-2 rounded text-center transition">Hủy</a>
        </div>
    </form>
</div>