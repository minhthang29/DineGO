@{
    ViewData["Title"] = "Hướng dẫn Action Notification";
    Layout = "../../Views/Shared/_Layout.cshtml";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg">
            <div class="bg-gradient-to-r from-blue-500 to-purple-600 text-white px-6 py-4 rounded-t-lg">
                <h3 class="text-2xl font-bold flex items-center">
                    <i class="fas fa-book mr-3"></i>
                    Hướng dẫn tạo Action cho Notification
                </h3>
            </div>
            <div class="p-6">
                
                <!-- Overview -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                    <h5 class="text-lg font-semibold text-blue-800 flex items-center mb-2">
                        <i class="fas fa-info-circle mr-2"></i> Tổng quan
                    </h5>
                    <p class="text-blue-700">Action trong notification quyết định điều gì xảy ra khi khách hàng click vào thông báo. 
                    Có 6 loại action chính bạn có thể sử dụng.</p>
                </div>

                <!-- Action Types Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                    
                    <!-- 1. No Action -->
                    <div class="border border-gray-300 rounded-lg overflow-hidden shadow-md">
                        <div class="bg-gray-500 text-white px-4 py-3">
                            <h5 class="text-lg font-semibold flex items-center">
                                <i class="fas fa-ban mr-2"></i> 1. Không có hành động
                            </h5>
                        </div>
                        <div class="p-4">
                            <p class="mb-2"><strong>Khi nào dùng:</strong> Thông báo chỉ để thông tin, không cần hành động.</p>
                            <p class="mb-2"><strong>Ví dụ:</strong> "Chúc mừng sinh nhật!", "Hệ thống bảo trì từ 2h-4h sáng"</p>
                            <p class="mb-3"><strong>Kết quả:</strong> Click vào chỉ đóng notification panel.</p>
                            <div class="bg-gray-100 border border-gray-300 rounded p-3 text-gray-700">
                                <strong class="">Action value:</strong> 
                                <code class="bg-gray-200 px-2 py-1 rounded text-sm">null</code> (để trống)
                            </div>
                        </div>
                    </div>

                    <!-- 2. Simple URL -->
                    <div class="border border-blue-300 rounded-lg overflow-hidden shadow-md">
                        <div class="bg-blue-500 text-white px-4 py-3">
                            <h5 class="text-lg font-semibold flex items-center">
                                <i class="fas fa-link mr-2"></i> 2. URL đơn giản
                            </h5>
                        </div>
                        <div class="p-4">
                            <p class="mb-2"><strong>Khi nào dùng:</strong> Chuyển hướng trực tiếp đến một trang cụ thể.</p>
                            <p class="mb-2"><strong>Ví dụ sử dụng:</strong></p>
                            <ul class="list-disc list-inside mb-3 text-sm space-y-1">
                                <li>Xem trang cá nhân: <code class="bg-gray-200 px-1 rounded">/Customer/Profile</code></li>
                                <li>Xem đơn hàng: <code class="bg-gray-200 px-1 rounded">/Customer/Orders</code></li>
                                <li>Xem menu: <code class="bg-gray-200 px-1 rounded">/Home/Menu</code></li>
                                <li>Trang khuyến mãi: <code class="bg-gray-200 px-1 rounded">/Home/Promotions</code></li>
                            </ul>
                            <div class="bg-blue-50 border border-blue-300 rounded p-3 text-blue-700">
                                <strong class="">Action value:</strong> 
                                <code class="bg-blue-100 px-2 py-1 rounded text-sm">/Customer/Profile</code>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Simple Action -->
                    <div class="border border-green-300 rounded-lg overflow-hidden shadow-md">
                        <div class="bg-green-500 text-white px-4 py-3">
                            <h5 class="text-lg font-semibold flex items-center">
                                <i class="fas fa-mouse-pointer mr-2"></i> 3. Action đơn giản
                            </h5>
                        </div>
                        <div class="p-4">
                            <p class="mb-2"><strong>Khi nào dùng:</strong> Sử dụng action có sẵn trong hệ thống.</p>
                            <p class="mb-2"><strong>Các action có sẵn:</strong></p>
                            <ul class="list-disc list-inside mb-3 text-sm space-y-1">
                                <li><code class="bg-gray-200 px-1 rounded">order_tracking</code> → Trang theo dõi đơn hàng</li>
                                <li><code class="bg-gray-200 px-1 rounded">profile</code> → Trang cá nhân</li>
                                <li><code class="bg-gray-200 px-1 rounded">cart</code> → Giỏ hàng</li>
                            </ul>
                            <p class="mb-3"><strong>Ưu điểm:</strong> Dễ dùng, không cần nhớ URL.</p>
                            <div class="bg-green-50 border border-green-300 rounded p-3 text-green-700">
                                <strong class="">Action value:</strong> 
                                <code class="bg-green-100 px-2 py-1 rounded text-sm">order_tracking</code>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Order Details -->
                    <div class="border border-yellow-300 rounded-lg overflow-hidden shadow-md">
                        <div class="bg-yellow-500 text-white px-4 py-3">
                            <h5 class="text-lg font-semibold flex items-center">
                                <i class="fas fa-shopping-bag mr-2"></i> 4. Chi tiết đơn hàng
                            </h5>
                        </div>
                        <div class="p-4">
                            <p class="mb-2"><strong>Khi nào dùng:</strong> Chuyển đến trang chi tiết một đơn hàng cụ thể.</p>
                            <p class="mb-2"><strong>Ví dụ:</strong></p>
                            <ul class="list-disc list-inside mb-3 text-sm space-y-1">
                                <li>"Đơn hàng #123 đã được xác nhận"</li>
                                <li>"Đơn hàng #456 đang được giao"</li>
                                <li>"Đơn hàng #789 đã hoàn thành"</li>
                            </ul>
                            <p class="mb-3"><strong>Cần nhập:</strong> Order ID (số)</p>
                            <div class="bg-yellow-50 border border-yellow-300 rounded p-3 text-yellow-700">
                                <strong class="">Action value:</strong> 
                                <code class="bg-yellow-100 px-2 py-1 rounded text-sm">{"type": "order_details", "orderId": 123}</code>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Promotion -->
                    <div class="border border-red-300 rounded-lg overflow-hidden shadow-md">
                        <div class="bg-red-500 text-white px-4 py-3">
                            <h5 class="text-lg font-semibold flex items-center">
                                <i class="fas fa-gift mr-2"></i> 5. Khuyến mãi
                            </h5>
                        </div>
                        <div class="p-4">
                            <p class="mb-2"><strong>Khi nào dùng:</strong> Chuyển đến trang một chương trình khuyến mãi cụ thể.</p>
                            <p class="mb-2"><strong>Ví dụ:</strong></p>
                            <ul class="list-disc list-inside mb-3 text-sm space-y-1">
                                <li>"Giảm 50% cho lần đầu đặt hàng!"</li>
                                <li>"Flash sale 12h trưa - Giảm 30%!"</li>
                                <li>"Combo tiết kiệm chỉ 99k!"</li>
                            </ul>
                            <p class="mb-3"><strong>Cần nhập:</strong> Promotion ID (số)</p>
                            <div class="bg-red-50 border border-red-300 rounded p-3 text-red-700">
                                <strong class="">Action value:</strong> 
                                <code class="bg-red-100 px-2 py-1 rounded text-sm">{"type": "promotion", "promoId": 456}</code>
                            </div>
                        </div>
                    </div>

                    <!-- 6. Redirect -->
                    <div class="border border-indigo-300 rounded-lg overflow-hidden shadow-md">
                        <div class="bg-indigo-500 text-white px-4 py-3">
                            <h5 class="text-lg font-semibold flex items-center">
                                <i class="fas fa-external-link-alt mr-2"></i> 6. Chuyển hướng
                            </h5>
                        </div>
                        <div class="p-4">
                            <p class="mb-2"><strong>Khi nào dùng:</strong> Chuyển đến trang bên ngoài hoặc mở tab mới.</p>
                            <p class="mb-2"><strong>Ví dụ:</strong></p>
                            <ul class="list-disc list-inside mb-3 text-sm space-y-1">
                                <li>Link đến trang Facebook của nhà hàng</li>
                                <li>Survey khách hàng trên Google Forms</li>
                                <li>Trang đánh giá trên Google</li>
                            </ul>
                            <p class="mb-3"><strong>Cần nhập:</strong> URL đầy đủ + tùy chọn tab mới</p>
                            <div class="bg-indigo-50 border border-indigo-300 rounded p-3 text-indigo-700">
                                <strong class="">Action value:</strong> 
                                <code class="bg-indigo-100 px-2 py-1 rounded text-xs">{"type": "redirect", "url": "https://facebook.com/restaurant", "newTab": true}</code>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Best Practices -->
                <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
                    <h5 class="text-lg font-semibold text-green-800 flex items-center mb-4">
                        <i class="fas fa-lightbulb mr-2"></i> Gợi ý sử dụng
                    </h5>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <h6 class="font-semibold text-green-700 mb-2">📱 Thông báo đơn hàng:</h6>
                            <ul class="text-sm text-green-600 space-y-1">
                                <li>Đặt hàng thành công → <strong>Order Details</strong></li>
                                <li>Đang giao hàng → <strong>Order Tracking</strong></li>
                                <li>Đã giao → <strong>Order Details</strong></li>
                            </ul>
                        </div>
                        <div>
                            <h6 class="font-semibold text-green-700 mb-2">🎁 Thông báo khuyến mãi:</h6>
                            <ul class="text-sm text-green-600 space-y-1">
                                <li>Sale mới → <strong>Promotion</strong></li>
                                <li>Voucher cá nhân → <strong>Simple URL</strong></li>
                                <li>Event đặc biệt → <strong>Redirect</strong></li>
                            </ul>
                        </div>
                        <div>
                            <h6 class="font-semibold text-green-700 mb-2">ℹ️ Thông báo hệ thống:</h6>
                            <ul class="text-sm text-green-600 space-y-1">
                                <li>Bảo trì → <strong>No Action</strong></li>
                                <li>Cập nhật tính năng → <strong>Simple URL</strong></li>
                                <li>Thông báo chung → <strong>No Action</strong></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Common Mistakes -->
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-6 mb-6">
                    <h5 class="text-lg font-semibold text-amber-800 flex items-center mb-4">
                        <i class="fas fa-exclamation-triangle mr-2"></i> Lưu ý quan trọng
                    </h5>
                    <ul class="text-amber-700 space-y-2">
                        <li class="flex items-start">
                            <i class="fas fa-dot-circle text-amber-500 mt-1 mr-2 text-xs"></i>
                            <span><strong>URL phải bắt đầu bằng "/"</strong> - Ví dụ: <code class="bg-amber-100 px-1 rounded">/Customer/Profile</code> chứ không phải <code class="bg-red-100 px-1 rounded">Customer/Profile</code></span>
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-dot-circle text-amber-500 mt-1 mr-2 text-xs"></i>
                            <span><strong>Order ID và Promotion ID phải là số</strong> - Không được để trống</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-dot-circle text-amber-500 mt-1 mr-2 text-xs"></i>
                            <span><strong>External URL phải có http://</strong> - Ví dụ: <code class="bg-amber-100 px-1 rounded">https://google.com</code></span>
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-dot-circle text-amber-500 mt-1 mr-2 text-xs"></i>
                            <span><strong>Test action trước khi gửi</strong> - Đảm bảo link hoạt động đúng</span>
                        </li>
                    </ul>
                </div>

                <!-- Quick Examples Section -->
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-6 mb-6">
                    <h5 class="text-lg font-semibold text-slate-800 flex items-center mb-4">
                        <i class="fas fa-code mr-2"></i> Ví dụ nhanh
                    </h5>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <h6 class="font-medium text-slate-700 mb-2">✅ Đúng:</h6>
                            <div class="space-y-2 text-sm text-slate-600">
                                <div class="bg-green-100 border border-green-300 rounded p-2">
                                    <code>/Customer/Profile</code>
                                </div>
                                <div class="bg-green-100 border border-green-300 rounded p-2">
                                    <code>order_tracking</code>
                                </div>
                                <div class="bg-green-100 border border-green-300 rounded p-2">
                                    <code>{"type": "order_details", "orderId": 123}</code>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h6 class="font-medium text-slate-700 mb-2">❌ Sai:</h6>
                            <div class="space-y-2 text-sm text-slate-600">
                                <div class="bg-red-100 border border-red-300 rounded p-2">
                                    <code>Customer/Profile</code> <span class="text-red-600">(thiếu /)</span>
                                </div>
                                <div class="bg-red-100 border border-red-300 rounded p-2">
                                    <code>google.com</code> <span class="text-red-600">(thiếu https://)</span>
                                </div>
                                <div class="bg-red-100 border border-red-300 rounded p-2">
                                    <code>{"type": "order_details"}</code> <span class="text-red-600">(thiếu orderId)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Back Buttons -->
                <div class="text-center space-x-4">
                    <a href="@Url.Action("Create", "Notification")" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow transition duration-200">
                        <i class="fas fa-arrow-left mr-2"></i> Quay lại tạo thông báo
                    </a>
                    <a href="@Url.Action("Index", "Notification")" class="inline-flex items-center px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-lg shadow transition duration-200">
                        <i class="fas fa-list mr-2"></i> Danh sách thông báo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>