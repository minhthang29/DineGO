@model Core.Models.Voucher
@{
    ViewData["Title"] = "Chỉnh sửa Voucher";
    Layout = "../../Views/Shared/_Layout.cshtml";
}

<div class="max-w-xl mx-auto mt-8 bg-white dark:bg-gray-800 rounded-lg shadow p-8">
    <h2 class="text-2xl font-bold text-center mb-6">Chỉnh sửa Voucher</h2>
    <form asp-action="Edit" method="post" class="space-y-5">
        <input type="hidden" name="voucher_id" value="@Model.voucher_id" />

        <div>
            <label class="block font-semibold mb-1">Mã voucher</label>
            <input id="voucher_code" name="voucher_code"
                   class="text-black w-full border rounded px-3 py-2"
                   value="@Model.voucher_code" required />
        </div>

        <div>
            <label class="block font-semibold mb-1">Giá trị giảm</label>
            <input id="voucher_discount" name="voucher_discount" type="number" step="0.01"
                   class="text-black w-full border rounded px-3 py-2"
                   value="@Model.voucher_discount" required />
        </div>

        <!-- ✅ Trường số tiền giảm tối đa -->
        <div id="cap_amount_field" class="@(Model.voucher_type == 0 ? "" : "hidden")">
            <label class="block font-semibold mb-1">Số tiền giảm tối đa (VND)</label>
            <input name="voucher_cap_amount" type="number" min="0"
                   value="@(Model.voucher_cap_amount ?? 0)"
                   class="text-black w-full border rounded px-3 py-2" />
        </div>

        <div>
            <label class="block font-semibold mb-1">Loại giảm giá</label>
            <select id="voucher_type" name="voucher_type"
                    class="text-black w-full border rounded px-3 py-2">
                <option value="0" @(Model.voucher_type == 0 ? "selected" : "")>Phần trăm (%)</option>
                <option value="1" @(Model.voucher_type == 1 ? "selected" : "")>Số tiền cố định</option>
            </select>
        </div>

        <div>
            <label class="block font-semibold mb-1">Số lượng</label>
            <input name="voucher_stock" type="number" min="1"
                   class="text-black w-full border rounded px-3 py-2"
                   value="@Model.voucher_stock" />
        </div>

        <div>
            <label class="block font-semibold mb-1">Ngày bắt đầu</label>
            <input name="voucher_start_date" type="date"
                   class="text-black w-full border rounded px-3 py-2"
                   value="@Model.voucher_start_date.ToString("yyyy-MM-dd")" required />
        </div>

        <div>
            <label class="block font-semibold mb-1">Ngày hết hạn</label>
            <input name="voucher_end_date" type="date"
                   class="text-black w-full border rounded px-3 py-2"
                   value="@Model.voucher_end_date.ToString("yyyy-MM-dd")" required />
        </div>

        <div>
            <label class="block font-semibold mb-1">Trạng thái</label>
            <select name="voucher_is_active"
                    class="text-black w-full border rounded px-3 py-2">
                <option value="true" @(Model.voucher_is_active ? "selected" : "")>Kích hoạt</option>
                <option value="false" @(!Model.voucher_is_active ? "selected" : "")>Không kích hoạt</option>
            </select>
        </div>

        <div>
            <label class="block font-semibold mb-1">Áp dụng cho</label>
            <select class="text-black w-full border rounded px-3 py-2" disabled>
                <option value="0" @(Model.voucher_apply_type == 0 ? "selected" : "")>Tất cả</option>
                <option value="1" @(Model.voucher_apply_type == 1 ? "selected" : "")>Khách hàng cụ thể</option>
                <option value="2" @(Model.voucher_apply_type == 2 ? "selected" : "")>Khác</option>
            </select>
            <input type="hidden" name="voucher_apply_type" value="@Model.voucher_apply_type" />
        </div>

        <div>
            <label class="block font-semibold mb-1">Điểm yêu cầu</label>
            <input id="required_points" name="required_points" type="number" min="0"
                   class="text-black w-full border rounded px-3 py-2"
                   value="@Model.required_points" readonly />
        </div>

        <div class="flex gap-3 mt-6">
            <button type="submit"
                    class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded transition">
                Lưu
            </button>
            <a href="@Url.Action("Index", "Voucher")"
               class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-2 rounded text-center transition">
                Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const codeInput = document.getElementById("voucher_code");
        const discountInput = document.getElementById("voucher_discount");
        const typeSelect = document.getElementById("voucher_type");
        const pointsInput = document.getElementById("required_points");
        const capAmountField = document.getElementById("cap_amount_field");

        // 👉 Toggle cap field theo loại giảm giá
        function toggleCapField() {
            if (typeSelect.value === "0") {
                capAmountField.classList.remove("hidden");
            } else {
                capAmountField.classList.add("hidden");
            }
        }
        typeSelect.addEventListener("change", toggleCapField);
        toggleCapField();

        // 👉 Mã voucher auto uppercase
        codeInput.addEventListener("input", function () {
            this.value = this.value.toUpperCase();
        });

        // 👉 Auto set required_points
        function updatePoints() {
            let discount = parseFloat(discountInput.value) || 0;
            let type = parseInt(typeSelect.value);
            let points = 0;

            if (type === 0) {
                points = Math.round(discount * 100);
            } else {
                points = Math.round(discount * 0.01);
            }
            pointsInput.value = points;
        }
        discountInput.addEventListener("input", updatePoints);
        typeSelect.addEventListener("change", updatePoints);

        // 👉 Check khi submit form
        const form = document.querySelector("form");
        form.addEventListener("submit", function (e) {
            const type = parseInt(typeSelect.value);
            const discount = parseFloat(discountInput.value) || 0;

            if (type === 0 && discount > 40) {
                e.preventDefault();
                showNotification("Voucher % chỉ được phép tối đa 40%", "danger");
                return false;
            }
        });

        document.addEventListener("DOMContentLoaded", updatePoints);
    </script>
}
