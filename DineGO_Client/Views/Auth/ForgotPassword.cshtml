@{
    ViewData["Title"] = "ForgotPassword";
}
<div class="login-background d-flex justify-content-center align-items-center" style="min-height: 100vh; padding: 15px;">
    <div class="login-container w-100 d-flex justify-content-center">
        <div class="login-block shadow-lg bg-white p-4 rounded" style="max-width: 600px; width: 100%;">
            <h4 class="login-header text-center mb-4">QUÊN MẬT KHẨU</h4>
            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="alert alert-info text-center">@ViewBag.Message</div>
            }
            <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                <div class="form-group mb-3">
                    <input type="email" id="email" name="email" required placeholder="Nhập email của bạn" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary btn-block w-100">Gửi yêu cầu</button>
                <div class="login-footer text-center mt-3">
                    <a asp-controller="Auth" asp-action="Login">Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>
