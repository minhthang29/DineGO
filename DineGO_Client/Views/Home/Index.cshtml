@using Microsoft.AspNetCore.Http
@model Core.Models.Client.Custom.CustomHomeViewModel
@{
    ViewData["Title"] = "Home Page";
}
<div class="container mt-5">
    <div class="row align-items-center yellow-bg--banner">
        @if (ViewBag.BannerAds != null &&
                ((List<Core.Models.Client.Custom.AdRegistrationResponseDto>)ViewBag.BannerAds).Any())
        {
            var bannerAds = (List<Core.Models.Client.Custom.AdRegistrationResponseDto>)ViewBag.BannerAds;

            <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < bannerAds.Count; i++)
                    {
                        var ad = bannerAds[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <a href="@ad.ad_link_url" target="_blank">
                                <div class="banner-ad-wrapper">
                                    <img src="@(ad.ad_image_url.StartsWith("http") 
                                                                                                             ? ad.ad_image_url 
                                                                                                             : $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/ads/full_{ad.ad_image_url}")"
                                    class="banner-ad-img" alt="Ad Banner"
                                    onerror="this.onerror=null;this.src='/common/images/banner.jpg';" />
                            </div>
                        </a>
                    </div>

                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
                }
                else
        {
            <!-- Fallback khi không có quảng cáo banner -->
            <div class="col-md-6 col-12 text-center mb-3 mb-md-0">
                <img src="/common/images/banner.jpg" alt="Hai Lạng Một" class="img-fluid">
            </div>
            <div class="col-md-6 col-12 text-center">
                <h2 class="fw-bold">Hai Lạng Một - Cần Thơ</h2>
                <p>Nhà hàng BBQ ngon, nổi tiếng tại Cần Thơ, kết hợp tinh hoa ẩm thực Trung, Nhật, Hàn.</p>
                <a class="btn btn-custom--banner" asp-controller="Restaurant" asp-action="Search">Xem ngay</a>
            </div>
        }
    </div>
</div>
<div class="fluid-container my-5">
    <div class="container my-5">
        <h3 class="mb-4">Nhà hàng nổi bật</h3>
        <div class="restaurant-container">
            @foreach (var restaurant in Model.Restaurants.Take(4))
            {
                <a href="@Url.Action("Details", "Restaurant", new { id = restaurant.res_id })" class="restaurant-card-link">
                    <div class="restaurant-card">
                        <img src="@(restaurant.res_images_json != null && restaurant.res_images_json.Count > 0 
                                                         ? $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/restaurants/full_{restaurant.res_images_json.First()}" 
                                                         : Url.Content("~/common/images/banner.jpg"))" alt="Restaurant Image"
                            class="restaurant-image" onerror="this.onerror=null;this.src='/common/images/banner.jpg';" />

                        <div class="restaurant-content p-2">
                            <!-- Tên nhà hàng -->
                            <h5 class="restaurant-name fw-bold text-dark mb-2">
                                @restaurant.res_name
                            </h5>

                            <!-- Địa chỉ + Giờ mở cửa -->
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>📍 @restaurant.res_address</span>
                                <span>⏰ @(restaurant.res_open_time?.ToString(@"hh\:mm") ?? "--:--") -
                                    @(restaurant.res_close_time?.ToString(@"hh\:mm") ?? "--:--")</span>
                            </div>

                            <!-- Phone -->
                            @if (!string.IsNullOrEmpty(restaurant.res_phone))
                            {
                                <div class="small text-muted mb-2">
                                    📞 @restaurant.res_phone
                                </div>
                            }

                            <!-- Rating + Phí đặt cọc -->
                            @{
                                var rate = restaurant.res_rate ?? 0;
                                int fullStars = (int)Math.Floor(rate);
                                double rateValue = Convert.ToDouble(rate);
                                bool hasHalfStar = (rateValue - fullStars) >= 0.5;
                                int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

                                var starHtml = new System.Text.StringBuilder();
                                for (int i = 0; i < fullStars; i++) { starHtml.Append("★"); }
                                if (hasHalfStar) { starHtml.Append("⯨"); }
                                for (int i = 0; i < emptyStars; i++) { starHtml.Append("☆"); }
                            }
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="rating text-warning">
                                    @Html.Raw(starHtml.ToString())
                                    <small>(@restaurant.res_rate_count đánh giá)</small>
                                </span>
                                <span class="restaurant-detail-fee text-danger fw-semibold">
                                    @string.Format("{0:N0} VND", restaurant.res_reservation_fee)
                                </span>
                            </div>

                            <!-- Nút đặt chỗ -->
                            <button class="btn btn-danger w-100 fw-bold mt-3">
                                Đặt chỗ ngay
                            </button>
                        </div>

                    </div>
                </a>
            }
        </div>
        <div class="text-center mt-3">
            <a class="text-muted" asp-controller="Restaurant" asp-action="Search" style="text-decoration: none;">
                Xem thêm
            </a>
        </div>
    </div>
</div>
<div class="container my-5">
    <h3 class="mb-4">Tin tức được xem nhiều nhất tháng</h3>
    <div class="owl-carousel owl-theme">
        @foreach (var blog in Model.Blogs.Take(3))
        {
            <div class="carousel-card">
                <img src="@(string.IsNullOrEmpty(blog.blog_image) 
                                                              ? "https://images.unsplash.com/photo-1506748686214-e9df14d4d9d0" 
                                                              : $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/blogs/thumb_{blog.blog_image}")"
                    alt="@blog.blog_title">
                <p>@blog.blog_title</p>
            </div>
        }
    </div>
</div>

<div class="container my-5">
    <h3 class="mb-4">Blog mới</h3>
    <div class="row">
        @foreach (var blog in Model.Blogs.Take(6))
        {
            <div class="col-md-6 mb-3">
                <div class="d-flex">
                    <img src="@(string.IsNullOrEmpty(blog.blog_image) 
                                                                          ? "https://images.unsplash.com/photo-1506748686214-e9df14d4d9d0" 
                                                                          : $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/blogs/thumb_{blog.blog_image}")"
                        alt="@blog.blog_title" class="me-3" style="width: 100px; height: 100px; object-fit: cover;">
                    <div>
                        <h6>
                            <a href="@Url.Action("ViewBlogDetail", "Blog", new { id = blog.blog_id })">
                                @blog.blog_title
                            </a>
                        </h6>
                        <p class="mb-1" style="font-size: 13px;">@blog.blog_date.ToString("dd/MM/yyyy")</p>
                        <div class="blog-content-short">
                            @Html.Raw(blog.blog_information)
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="text-center mt-3">
        <a class="text-muted" asp-controller="Blog" asp-action="Index" style="text-decoration: none;">
            Xem thêm
        </a>
    </div>
</div>


<link rel="stylesheet" href="~/client/css/blog.css">
@if (ViewBag.PopupAd != null)
{
    var popupAd = (Core.Models.Client.Custom.AdRegistrationResponseDto)ViewBag.PopupAd;

    <div class="modal fade" id="popupAdModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body p-0 position-relative text-center">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-2"
                            data-bs-dismiss="modal" aria-label="Đóng"></button>

                    <a href="@popupAd.ad_link_url" target="_blank">
                        <img src="@(popupAd.ad_image_url.StartsWith("http") 
                                     ? popupAd.ad_image_url 
                                     : $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/ads/full_{popupAd.ad_image_url}")"
                             class="img-fluid rounded"
                             style="max-height:500px; object-fit:contain; background:#fff;"
                             alt="Popup Ad"
                             onerror="this.onerror=null;this.src='/common/images/banner.jpg';" />
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const lastShown = localStorage.getItem("popupAdLastShown");
            const now = Date.now();
            const cooldown = 30 * 60 * 1000; // 30 phút
            @* const cooldown =10; // 30 phút *@

            if (!lastShown || (now - lastShown) > cooldown) {
                const popup = new bootstrap.Modal(document.getElementById("popupAdModal"));
                popup.show();
                localStorage.setItem("popupAdLastShown", now);
            }
        });
    </script>
}
