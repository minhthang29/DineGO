@using Newtonsoft.Json
@{
    ViewData["Title"] = "Booking";
}

<div class="container mt-5">
    <div class="booking-container">
        <!-- Tiêu đề -->
        <div class="d-flex flex-wrap justify-content-center gap-2 text-center">
            <h1>Đặt chỗ đến</h1>
            <h1 class="text-danger fw-bold">@Model.Restaurant.res_name</h1>
        </div>

        <div class="row justify-content-center mt-4">
            <!-- Form Đặt Chỗ -->
            <div class="col-12 col-md-10 col-lg-8">
                <form id="reservationForm" action="/Reservation/CreateReservation" method="post">
                    <input type="hidden" name="res_id" value="@Model.Restaurant.res_id">

                    <div class="booking-container p-3 border rounded shadow bg-white">
                        <div class="row g-3 mb-3">
                            <!-- Khu vực (col-md-6, giữ d-flex cho label + select ngang) -->
                            <div class="col-md-6 align-items-center gap-2">
                                <label class="fw-bold text-danger mb-0 whitespace-nowrap">
                                    <i class="fas fa-map-marker-alt"></i> Khu vực:
                                </label>
                                <select class="form-select flex-fill" id="areaSelector" required>
                                    @foreach (var area in Model.Areas)
                                    {
                                        <option value="@area.area_id">@area.area_name</option>
                                    }
                                </select>
                            </div>
                            <!-- Thời gian đến (col-md-6) -->
                            <div class="col-md-6 align-items-center gap-2">
                                <label class="fw-bold text-danger d-block mb-2">
                                    <i class="fas fa-clock"></i> Thời gian đến
                                </label>
                                <input type="date" class="form-control" name="reser_date_date" required
                                    min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                    max="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")"
                                    value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <!-- Danh sách bàn -->
                        <div class="mb-3">
                            <div class="mb-3 d-flex flex-wrap gap-3 align-items-center">
                                <label class="fw-bold text-danger mb-0">
                                    <i class="fas fa-utensils"></i> Bàn
                                </label>
                            </div>
                            <div id="noTableMessage" class="alert alert-info text-center d-none">
                                Chưa có bàn nào trong khu vực này.
                            </div>
                            <div id="booking-table-layout" class="d-grid grid-layout"></div>
                            <input type="hidden" name="table_id" id="selectedTableId" />
                        </div>

                        <!-- Chọn thời gian theo slot -->
                        <div class="mb-3">
                            <label class="fw-bold text-danger d-block mb-2">
                                <i class="fas fa-clock"></i> Giờ khả dụng
                            </label>
                            <div id="timeSlotContainer" class="d-flex flex-wrap gap-2">
                                <!-- Slot khả dụng sẽ được render bằng JS -->
                            </div>
                            <input type="hidden" name="reser_date_time" id="selectedTimeSlot" required />
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-danger">
                                <i class="fas fa-sticky-note"></i> Ghi chú
                            </label>
                            <textarea class="form-control" name="reser_note" placeholder="Nhập ghi chú"></textarea>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 mt-2">
                            Thanh toán bằng QR
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/client/css/table.css" />
<link rel="stylesheet" href="/client/css/reservation.css" />
<script id="table-data" type="application/json">
    @Html.Raw(JsonConvert.SerializeObject(Model.Tables))
</script>
<script src="~/client/js/reservation.js" asp-append-version="true"></script>

@section Scripts {
    <script src="~/client/js/table-status-signalr.js"></script>
    @* <script>
        startTableSignalR(updateTableStatusUIById);
    </script> *@
}