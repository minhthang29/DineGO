@using Microsoft.AspNetCore.Http
@using System.Text.Json
@model Core.Models.Client.Custom.PostDetailsViewModel
@await Html.PartialAsync("_Notification")

<div class="row g-0">
  <!-- Ảnh/Video bên trái (desktop) / trên (mobile) -->
  <div class="col-12 col-md-8 bg-black position-relative p-0 
              d-flex justify-content-center align-items-center 
              order-1 order-md-1">
    @{
      var images = Model.Post.post_images_json ?? new List<string>(); // Fallback empty list nếu null
      var hasVideo = !string.IsNullOrEmpty(Model.Post.post_video);
      var videoUrl = hasVideo ? $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/posts/videos/{Model.Post.post_video}" : null;
    }

    @if (hasVideo)
    {
      <!-- 👈 THÊM MỚI: Hiển thị Video Player (ưu tiên nếu có video) -->
      <div class="w-100 h-100 d-flex justify-content-center align-items-center">
        <video src="@videoUrl" 
               controls 
               class="d-block mx-auto viewer-video"
               style="max-height: 90vh; width: 100%; height: auto; object-fit: contain;"
               poster="https://via.placeholder.com/600x400?text=Video+Preview"> <!-- Optional poster nếu cần thumbnail -->
          Trình duyệt không hỗ trợ video HTML5.
        </video>
      </div>

      @* Conflict check: Nếu có cả video và ảnh (không nên theo BR), log warning *@
      @if (images.Count > 0)
      {
        <script>
          console.warn("⚠️ Post @Model.Post.post_id có cả video và ảnh (vi phạm BR). Ưu tiên hiển thị video.");
        </script>
      }
    }
    else if (images.Count > 0)
    {
      <!-- Giữ nguyên: Carousel Ảnh (nếu không có video) -->
      <div id="postCarousel"
           class="carousel slide image-viewer-wrapper d-flex align-items-center justify-content-center w-100 h-100">
        <div class="carousel-inner h-100 w-100">
          @for (int i = 0; i < images.Count; i++)
          {
            <div class="carousel-item @(i == 0 ? "active" : "") text-center h-100">
              <img src="https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/posts/full_@images[i]"
                   class="d-block mx-auto h-100 viewer-img"
                   style="max-height: 90vh; object-fit: contain;" />
            </div>
          }
        </div>

        <button class="carousel-control-prev position-absolute start-0 top-50 translate-middle-y btn-nav-image"
                type="button" data-bs-target="#postCarousel" data-bs-slide="prev"
                style="width: 40px; height: 40px; z-index: 1055;">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next position-absolute end-0 top-50 translate-middle-y btn-nav-image"
                type="button" data-bs-target="#postCarousel" data-bs-slide="next"
                style="width: 40px; height: 40px; z-index: 1055;">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
      </div>
    }
    else
    {
      <!-- Placeholder nếu không có media -->
      <div class="w-100 h-100 d-flex justify-content-center align-items-center text-white">
        <div class="text-center">
          <i class="bi bi-image" style="font-size: 4rem; opacity: 0.5;"></i>
          <p class="mt-2">Không có ảnh hoặc video</p>
        </div>
      </div>
    }

    <!-- Nút X để đóng (giữ nguyên, hiển thị luôn) -->
    <button type="button" 
        class="btn-close position-absolute top-0 end-0 m-3" 
        style="filter: invert(1); border: 2px solid white; padding-left:8px;" 
        aria-label="Close" 
        data-bs-dismiss="modal">
    </button>
  </div>

  <!-- Nội dung bên phải (desktop) / dưới (mobile) - Giữ nguyên toàn bộ -->
  <div class="col-12 col-md-4 d-flex flex-column bg-white order-2 order-md-2" style="height: 90vh;">
      <!-- Header -->
      <div class="p-3 d-flex align-items-center flex-shrink-0">
        <img src="@($"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/customers/thumb_{Model.Post.customer?.cus_image}")"
             class="rounded-circle me-2" style="width: 60px; height: 60px; object-fit: cover;" />
        <div>
          <div class="fw-bold">@Model.Post.customer?.cus_name</div>
          <div class="text-muted small">
            @{
              var created = Model.Post.post_created_date;
              var updated = Model.Post.post_updated_date;

              if (updated == null || updated <= created)
              {
                @TimeAgo(created)
              }
              else
              {
                @(TimeAgo(updated)) <span class="fst-italic">(Đã chỉnh sửa)</span>
              }
            }
          </div>
        </div>
      </div>

      <!-- Caption -->
       <div class="px-3 py-2 border-bottom flex-shrink-0">
        <div>@Model.Post.post_content</div>
      </div>

      <!-- Like / Comment -->
     <div class="px-3 py-2 border-bottom text-muted small d-flex gap-4 flex-shrink-0">
        <div class="d-flex align-items-center gap-2">
          @await Html.PartialAsync("_ReactionMenu", (
            Model.Post.post_id,
            Model.Likes?.FirstOrDefault(l => l.post_id == Model.Post.post_id && l.cus_id == Model.Customer.cus_id)?.like_emotion_type ?? 0
          ))
          <span id="like-count-@Model.Post.post_id" class="reaction-count fw-semibold text-primary" style="cursor:pointer"
                onclick="showReactionsPopup(@Model.Post.post_id)">
            (@Model.Post.post_like_count)
          </span>
        </div>

        <div class="d-flex align-items-center gap-2 fw-bold">
          <i class="bi bi-chat-dots"></i> Bình luận
          <span id="comment-count-@Model.Post.post_id" class="reaction-count fw-semibold text-primary">
            @* (@Model.Post.post_comment_count) *@
          </span>
        </div>
      </div>

      <!-- Comment list -->
      <div class="flex-grow-1 overflow-auto px-3 py-2">
        @if (!Model.Comments.Any())
        {
          <div class="text-muted fst-italic">Chưa có bình luận nào.</div>
        }
        else
        {
          @foreach (var comment in Model.Comments.OrderByDescending(c => c.comment_created_date))
          {
            var user = Model.CommentAuthors.FirstOrDefault(u => u.cus_id == comment.cus_id);
            <div class="d-flex mb-3 position-relative" id="comment-box-@comment.comment_id">
              <img src="@($"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/customers/thumb_{user.cus_image}")"
                   class="rounded-circle me-2" style="width: 36px; height: 36px; object-fit: cover;" />

              <div class="bg-secondary-subtle rounded px-3 py-2 d-inline-block comment-content-area"
                   id="comment-content-@comment.comment_id">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="fw-bold">@user.cus_name</div>

                  @if (comment.cus_id == Model.Customer.cus_id)
                  {
                    <div class="custom-dropdown-wrapper ms-2">
                      <button class="bg-secondary-subtle btn btn-sm toggle-dropdown p-1" type="button">⋯</button>
                      <div class="custom-dropdown-menu d-none">
                        <div class="menu-item btn-edit-comment" data-comment-id="@comment.comment_id">
                          <i class="fas fa-edit text-primary"></i>
                        </div>
                        <div class="menu-item open-dynamic-modal" data-title="Xác nhận xoá bình luận" data-action="DeleteComment"
                             data-controller="Post" data-method="POST" data-type="delete" data-id="@comment.comment_id"
                             data-post-id="@comment.post_id">
                          <i class="fas fa-trash text-danger"></i>
                        </div>
                      </div>
                    </div>
                  }
                </div>

                <div class="comment-text" id="text-@comment.comment_id">@comment.comment_content</div>

                <!-- Form sửa bình luận -->
                <form class="edit-comment-form d-none" data-id="@comment.comment_id">
                  <input type="hidden" name="comment_id" value="@comment.comment_id" />
                  <input type="hidden" name="post_id" value="@Model.Post.post_id" />
                  <textarea name="comment_content" class="form-control mb-1">@comment.comment_content</textarea>
                  <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-success">Lưu</button>
                    <button type="button" class="btn btn-sm btn-secondary cancel-edit">Huỷ</button>
                  </div>
                </form>

                <div class="text-muted small mt-1">
                  @{
                    var created_comment = comment.comment_created_date;
                    var updated_comment = comment.comment_updated_date;

                    if (updated_comment == null || updated_comment <= created_comment)
                    {
                      @TimeAgo(created_comment)
                    }
                    else
                    {
                      @(TimeAgo(updated_comment)) <span class="fst-italic">(Đã chỉnh sửa)</span>
                    }
                  }
                </div>
              </div>
            </div>
          }
        }
      </div>

      <!-- Form nhập bình luận -->
      <div class="d-flex align-items-start comment-wrapper gap-2 p-3 flex-shrink-0 border-top">
        <!-- Avatar người dùng -->
        <div class="avatar-box">
          <img src="@($"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/customers/thumb_{Model.Customer.cus_image}")"
               class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" />
        </div>

        <!-- Nội dung bình luận -->
        <div class="comment-input-box flex-grow-1">
          <form id="commentForm-@Model.Post.post_id"
                class="d-flex align-items-center position-relative comment-form w-100 emoji-form-detail">
            <input type="hidden" name="post_id" value="@Model.Post.post_id" />
            <input type="hidden" name="cus_id" value="@Model.Customer.cus_id" />
            <input type="text"
                   name="comment_content"
                   class="comment-input"
                   placeholder="@($"Bình luận dưới tên {Model.Customer.cus_name}")"
                   required />
            <!-- Nút mở emoji -->
            <button type="button" class="btn emoji-toggle-btn" aria-label="Chọn emoji">
              <i class="fas fa-smile"></i>
            </button>

            <button type="submit" class="btn btn-sm send-btn">
              <svg xmlns="http://www.w3.org/2000/svg"
                   width="20" height="20" fill="gray"
                   viewBox="0 0 24 24">
                <path d="M2.01 21l20.99-9L2.01 3 2 10l15 2-15 2z" />
              </svg>
            </button>
          </form>
          <div class="emoji-picker mt-2 d-flex flex-wrap gap-2 d-none"></div>
        </div>
      </div>
  </div>
</div>

<script src="/client/js/post.js" asp-append-version="true"></script>

@functions {
  public string TimeAgo(DateTime dateTime)
  {
    var timeSpan = DateTime.Now - dateTime;
    if (timeSpan.TotalMinutes < 1) return "Vừa xong";
    if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes} phút trước";
    if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours} giờ trước";
    if (timeSpan.TotalDays < 30) return $"{(int)timeSpan.TotalDays} ngày trước";
    return dateTime.ToString("dd/MM/yyyy");
  }
}
