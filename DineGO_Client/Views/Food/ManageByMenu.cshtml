@model Core.Models.Client.Custom.FoodWithMenuViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_RestaurantPanel.cshtml";
    var menuId = Model.Menu.menu_id;
}

<div class="container py-4" style=" min-height: 450px;">

    <div class="food-wrapper shadow rounded-3 p-4 bg-white">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold text-danger m-0">
                🍽️ Danh sách món ăn trong menu: <span class="text-danger">@Model.Menu.menu_name</span>
            </h3>
            <a class="btn btn-danger shadow-sm" asp-controller="Food" asp-action="Create" asp-route-menuId="@menuId">📝
                Thêm món</a>
        </div>

        @if (!Model.Foods.Any())
        {
            <div class="alert alert-info">Chưa có món ăn nào!</div>
        }
        else
        {
            <div style="max-height: 500px; overflow-y: auto;">
                <table class="table table-bordered table-hover">
                    <thead class="table-danger sticky-top">
                        <tr>
                            <th>Tên món</th>
                            <th>Mô tả</th>
                            <th>Giá</th>
                            <th>Ảnh</th>
                            <th>Thời gian chế biến (phút)</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var food in Model.Foods)
                        {
                            <tr>
                                <td>@food.food_name</td>
                                <td>@food.food_description</td>
                                <td>@food.food_price.ToString("N0") VND</td>
                                <td>
                                    @foreach (var img in food.food_images)
                                    {
                                        <img src="https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/foods/thumb_@img"
                                            style="height: 80px; cursor: zoom-in;" class="img-thumbnail me-1"
                                            onclick="showFullImage('https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/foods/full_@img')"
                                            onerror="this.onerror=null;this.src='https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/foods/default.jpeg'" />
                                    }
                                </td>
                                <td>
                                    @if (food.food_prep_time.HasValue)
                                    {
                                        @food.food_prep_time
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @switch (food.food_status)
                                    {
                                        case 1:
                                            <span class="badge bg-success">Đang bán</span>
                                            break;
                                        case 0:
                                            <span class="badge bg-danger">Hết món</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning text-dark">@food.food_status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@food.food_id" class="btn btn-warning btn-sm">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@food.food_id" class="btn btn-danger btn-sm">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        }

    </div>
    <!-- Modal to display full-size food image -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark">
                <div class="modal-body p-0">
                    <img id="modalImage" src="" class="img-fluid w-100"
                        style="max-height: 80vh; object-fit: contain;" />
                </div>
            </div>
        </div>
    </div>

</div>
<script src="/client/js/imagePreview.js" asp-append-version="true"></script>