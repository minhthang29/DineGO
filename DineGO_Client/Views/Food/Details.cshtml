@model Core.Models.Food
@{
    ViewData["Title"] = "Details";
}

<section class="container-food-details py-5-food-details">
    <div class="container px-4 px-md-5">
        <div class="container row align-items-center">
            <!-- Ảnh bên trái -->
            <div class="col-md-6 text-center">
                <!-- Carousel ảnh -->
                @if (Model.food_images?.Count > 0)
                {
                    <div id="foodImagesCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.food_images.Count; i++)
                            {
                                var fileName = Model.food_images[i];
                                var imgUrl = $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/foods/full_{fileName}";
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@imgUrl" class="d-block w-100" style="max-height: 400px; object-fit: contain;"
                                        onerror="this.onerror=null; this.src='/common/images/banner.jpg';" />
                                </div>
                            }

                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#foodImagesCarousel"
                            data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#foodImagesCarousel"
                            data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                }

            </div>

            <!-- Nội dung bên phải -->
            <div class="col-md-6">
                @{
                    int? status = Model.food_status;
                    string statusText = status switch
                    {
                        1 => "Đang bán",
                        0 => "Hết món",
                        _ => "Không rõ"
                    };
                    string statusBadgeClass = status switch
                    {
                        1 => "badge bg-success rounded-pill",
                        0 => "badge bg-danger rounded-pill",
                        _ => "badge bg-secondary rounded-pill"
                    };
                }

                <div class="card border-0 shadow-sm food-info">
                    <div class="card-body p-4">

                        <!-- Nhà hàng + trạng thái -->
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div>
                                <div class="text-muted small">Nhà hàng</div>
                                <h2 class="h4 fw-bold m-0">
                                    <em>@(ViewBag.RestaurantName ?? "—")</em>
                                </h2>
                            </div>
                            <span class="@statusBadgeClass">@statusText</span>
                        </div>

                        <!-- Tên món -->
                        <div class="mb-3">
                            <div class="text-muted small">Tên món</div>
                            <h3 class="h3 fw-bold text-danger m-0">@Model.food_name</h3>
                        </div>

                        <!-- Mô tả -->
                        @if (!string.IsNullOrWhiteSpace(Model.food_description))
                        {
                            <div class="mb-3">
                                <div class="text-muted small">Mô tả</div>
                                <p class="mb-0 lh-base">@Model.food_description</p>
                            </div>
                        }

                        <hr class="my-4" />

                        <!-- Giá -->
                        <div class="d-flex align-items-baseline justify-content-between mb-3">
                            <span class="text-muted small">Giá</span>
                            <div class="display-6 text-danger fw-bold">
                                @Model.food_price.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture)
                                <span class="fs-6">VND</span>
                            </div>
                        </div>

                        <!-- CTA -->
                        @if (Model.food_status == 1)
                        {
                            <form class="d-flex flex-wrap align-items-center gap-2" id="add-to-cart-form-@Model.food_id">
                                <input type="hidden" id="foodId" value="@Model.food_id" />

                                <div class="input-group quantity-stepper" style="width: 180px;">
                                    <button class="btn btn-outline-secondary" type="button" data-role="qty-minus"
                                        data-target="#qty-@Model.food_id">−</button>

                                    <input type="number" class="form-control text-center" id="qty-@Model.food_id" value="1"
                                        min="1" max="50" step="1" />

                                    <button class="btn btn-outline-secondary" type="button" data-role="qty-plus"
                                        data-target="#qty-@Model.food_id">+</button>
                                </div>

                                <button type="button" class="btn btn-danger py-2 fw-semibold btn-add-cart"
                                    data-food-id="@Model.food_id" data-qty-input="#qty-@Model.food_id">
                                    Thêm vào giỏ hàng
                                </button>
                            </form>

                        }
                        else if (Model.food_status == 0)
                        {
                            <div class="alert alert-warning d-flex align-items-center gap-2 my-0" role="alert">
                                <span>⛔</span><span>Món này hiện đã hết.</span>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>


        <hr />
        <div class="d-flex align-items-baseline gap-3 flex-wrap mt-5 mb-3">
            <h4 class="mb-0">Món khác cùng nhà hàng</h4>
            <h2 class="h4 fw-bold m-0">
                <em>@(ViewBag.RestaurantName ?? "—")</em>
            </h2>
        </div>



        <div class="owl-carousel owl-theme">
            @foreach (var item in ViewBag.RelatedFoods as List<Core.Models.Food>)
            {
                <div class="item">
                    <div class="card card-food h-100">
                        <img src="@(string.IsNullOrEmpty(item.food_image)
                                                                                                                                                                                                                                                                                                                                   ? "/common/images/banner.jpg"
                                                                                                                                                                                                                                                                                                                                   : item.food_image.Trim().StartsWith("[")
                                                                                                                                                                                                                                                                                                                                       ? $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/foods/thumb_{System.Text.Json.JsonSerializer.Deserialize<List<string>>(item.food_image)?.FirstOrDefault() ?? ""}"
                                                                                                                                                                                                                                                                                                                                       : $"https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/foods/thumb_{item.food_image.Split(',')[0]}")"
                            class="card-img-top" onerror="this.onerror=null; this.src='/common/images/banner.jpg';"
                            alt="@item.food_name" />


                        <div class="card-body text-center">
                            <h5 class="card-title">@item.food_name</h5>
                            <p class="card-text text-danger fw-bold">
                                @item.food_price.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture) VND
                            </p>

                            <div class="d-flex justify-content-center gap-2">
                                <a href="/Food/Details/@item.food_id" class="btn btn-outline-danger btn-sm">Xem chi tiết</a>

                                @if (item.food_status == 1)
                                {
                                    <button type="button" class="btn btn-danger py-2 fw-semibold btn-add-cart"
                                    data-food-id="@Model.food_id" data-qty-input="#qty-@Model.food_id">
                                    Thêm vào giỏ hàng
                                    </button>
                                }
                                else if (item.food_status == 0)
                                {
                                    <span class="badge bg-danger align-self-center">Hết món</span>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

    </div>

</section>
<script>
document.addEventListener("click", async function (e) {
    const btn = e.target.closest(".btn-add-cart");
    if (!btn) return;

    const foodId = btn.dataset.foodId;
    const qtyInput = document.querySelector(btn.dataset.qtyInput);
    const quantity = parseInt(qtyInput?.value || "1", 10);

    try {
        const response = await fetch("/Cart/AddJson", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-Requested-With": "XMLHttpRequest"
            },
            body: JSON.stringify({ foodId, quantity })
        });

        const result = await response.json();

        if (response.ok && result.success) {
            showNotification("✅ Đã thêm món vào giỏ hàng!", "success");
        } else {
            showNotification(result.message || "❌ Không thể thêm vào giỏ!, bạn cần đăng nhập trước khi thêm món vào giỏ!", "danger");
        }
    } catch (err) {
        showNotification("❌ Lỗi: " + err.message, "danger");
    }
});

function showNotification(message, type = "success") {
    const container = document.getElementById("notification-container");
    container.innerHTML = "";

    const div = document.createElement("div");
    div.className = `alert alert-${type} d-flex align-items-center shadow-sm border-0 rounded-3`;
    div.role = "alert";

    let iconHtml = "";
    if (type === "success") {
        iconHtml = `<i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>`;
    } else if (type === "danger") {
        iconHtml = `<i class="bi bi-x-circle-fill me-2 fs-5 text-danger"></i>`;
    }

    div.innerHTML = `${iconHtml}<div>${message}</div>`;
    container.appendChild(div);

    setTimeout(() => {
        div.classList.add("fade");
        div.addEventListener("transitionend", () => div.remove());
    }, 3000);
}
</script>

<script>
    // Nút +/- như cũ
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('button[data-role]');
        if (!btn) return;

        const input = document.querySelector(btn.getAttribute('data-target'));
        if (!input) return;

        const min = parseInt(input.getAttribute('min') || '1', 10);
        const max = parseInt(input.getAttribute('max') || '50', 10);
        let val = parseInt(input.value || '1', 10);

        if (btn.getAttribute('data-role') === 'qty-minus') {
            val = Math.max(min, (isNaN(val) ? min : val - 1));
        } else {
            val = Math.min(max, (isNaN(val) ? min : val + 1));
        }
        input.value = val;
        clearQtyError(input);
    });

    // Chỉ giữ chữ số khi gõ, chặn e/E/+/-/. trên input[type=number]
    document.addEventListener('keydown', function (e) {
        const inp = e.target.closest('input[type="number"][name="quantity"]');
        if (!inp) return;
        const blocked = ['e', 'E', '+', '-', '.'];
        if (blocked.includes(e.key)) e.preventDefault();
    });

    // Làm sạch khi người dùng paste/gõ
    document.addEventListener('input', function (e) {
        const input = e.target.closest('input[type="number"][name="quantity"]');
        if (!input) return;
        input.value = (input.value || '').replace(/\D+/g, ''); // giữ số
    });

    // Sửa lệch range khi blur/change
    document.addEventListener('change', function (e) {
        const input = e.target.closest('input[type="number"][name="quantity"]');
        if (!input) return;
        enforceRange(input);
    });

    function enforceRange(input) {
        const min = parseInt(input.getAttribute('min') || '1', 10);
        const max = parseInt(input.getAttribute('max') || '50', 10);
        let val = parseInt(input.value || '0', 10);
        if (isNaN(val) || val < min) val = min;
        if (val > max) val = max;
        input.value = val;
        clearQtyError(input);
    }

    function showQtyError(input, msg) {
        input.classList.add('is-invalid');
        input.setCustomValidity(msg || 'Invalid');
        input.reportValidity(); // hiện tooltip native
    }
    function clearQtyError(input) {
        input.classList.remove('is-invalid');
        input.setCustomValidity('');
    }

    // Chặn submit nếu quantity invalid
    document.addEventListener('submit', function (e) {
        const form = e.target.closest('form[action$="/Cart/Add"]');
        if (!form) return;

        const input = form.querySelector('input[name="quantity"]');
        if (!input) return;

        const min = parseInt(input.getAttribute('min') || '1', 10);
        const max = parseInt(input.getAttribute('max') || '50', 10);
        const val = parseInt(input.value || '0', 10);

        if (isNaN(val) || val < min || val > max) {
            e.preventDefault();
            showQtyError(input, `Số lượng phải từ ${min} đến ${max}.`);
            return false;
        }
        clearQtyError(input);
    });
</script>