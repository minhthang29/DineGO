@model Core.Models.Client.Custom.FoodWithMenuViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_RestaurantPanel.cshtml";
    var food = Model.Foods.FirstOrDefault();
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 550px;">
    <div class="card shadow-lg p-4 rounded-4" style="width: 100%; max-width: 700px; background-color: #fff;">
        <h3 class="text-center fw-bold text-danger mb-4">
            🍤 Thêm món mới vào menu: <span class="text-dark">@Model.Menu.menu_name</span>
        </h3>

        <form asp-action="Create" enctype="multipart/form-data" id="foodForm">
            <input type="hidden" asp-for="Menu.menu_id" />

            <div class="mb-3">
                <label class="form-label fw-bold text-danger">Tên món</label>
                <input name="Foods[0].food_name" class="form-control rounded-3 border-danger" required id="foodName"
                    placeholder="Nhập tên món..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-danger">Mô tả</label>
                <textarea name="Foods[0].food_description" class="form-control rounded-3 border-danger"
                    id="foodDescription" rows="3" maxlength="200" required placeholder="Mô tả món ăn..."></textarea>
            </div>

            <div class="mb-3">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="fetchAITagSuggestions()">
                    Gợi ý tag từ AI
                </button>
                <div id="suggestedTags" class="d-flex flex-wrap gap-2 mt-2"></div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-danger">
                    Tag (giúp các món ăn của bạn dễ được đề xuất hơn!)
                </label>
                <input type="hidden" name="Foods[0].food_tag" id="tagSelected" />

                <div class="border rounded-3 p-3" style="min-height: 50px; background-color: #f8f9fa;">
                    <div id="selectedTags" class="d-flex flex-wrap gap-2"></div>
                </div>
            </div>

            @if (ViewBag.TagCategories != null)
            {
                <div class="mb-3">
                    <label class="form-label fw-bold text-danger">Tag phổ biến</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var tag in ViewBag.TagCategories as List<string>)
                        {
                            <span class="badge rounded-pill bg-secondary text-white px-3 py-2" style="cursor:pointer"
                                onclick="appendSelectedTag('@tag')">@tag</span>
                        }
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold text-danger">Giá (VND)</label>
                <input type="number" name="Foods[0].food_price" class="form-control rounded-3 border-danger" required
                    id="foodPrice" min="0" max="2000000" placeholder="Ví dụ: 35000" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold text-danger">Thời gian chế biến (phút)</label>
                <input type="number" name="Foods[0].food_prep_time" class="form-control rounded-3 border-danger"
                    id="foodPrepTime" min="1" max="20000" placeholder="Ví dụ: 15" />
                <small class="text-muted">Nhập thời gian chế biến món ăn (tính bằng phút)</small>
                <div id="foodPrepTimeError" class="text-danger mt-1"></div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-danger">Trạng thái</label>
                <select name="Foods[0].food_status" class="form-select rounded-3 border-danger" required
                    id="foodStatus">
                    <option value="">-- Chọn trạng thái --</option>
                    <option value="1">Đang bán</option>
                    <option value="0">Hết món</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-danger">Hình ảnh món ăn</label>
                <input type="file" name="imageFiles" class="form-control rounded-3 border-danger" multiple required
                    id="foodImage" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="ManageByMenu" asp-route-menuId="@Model.Menu.menu_id"
                    class="btn btn-outline-secondary rounded-3 px-4">Quay lại</a>
                <button type="submit" class="btn btn-danger rounded-3 px-4">Thêm</button>
            </div>
        </form>
    </div>
</div>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<script>
    document.getElementById("foodDescription").addEventListener("input", function () {
        if (this.value.length > 200) {
            showNotification("📖 Mô tả món ăn tối đa 200 ký tự.", "warning");
            this.value = this.value.substring(0, 200); // cắt bớt luôn
        }
    });

    async function fetchAITagSuggestions() {
        const description = document.getElementById("foodDescription").value.trim();
        if (!description) {
            showNotification("Vui lòng nhập mô tả món ăn!", "danger");
            return;
        }

        const container = document.getElementById("suggestedTags");
        container.innerHTML = `<span class="text-muted">⏳ Đang gợi ý tag từ AI...</span>`;

        try {
            const response = await fetch(`/Food/SuggestTagsFromDescription?description=${encodeURIComponent(description)}`);
            const raw = await response.text();

            if (!response.ok) {
                throw new Error(raw || "Unknown error (no message)");
            }

            const tags = JSON.parse(raw);
            container.innerHTML = "";
            tags.forEach(tag => {
                const span = document.createElement("span");
                span.className = "badge rounded-pill bg-danger text-white px-3 py-2";
                span.style.cursor = "pointer";
                span.textContent = tag;
                span.onclick = () => appendSelectedTag(tag);
                container.appendChild(span);
            });
        } catch (err) {
            console.error("🔥 Lỗi:", err.message || err);
            showNotification("Lỗi AI: " + (err.message || "Không rõ lỗi"), "danger");
            container.innerHTML = "";
        }
    }

    function appendSelectedTag(tag) {
        const selectedContainer = document.getElementById("selectedTags");
        const input = document.getElementById("tagSelected");
        let current = input.value.split(',').map(t => t.trim()).filter(t => t);

        if (current.includes(tag)) return;
        if (current.length >= 3) {
            showNotification("Chỉ được chọn tối đa 3 tag!", "danger");
            return;
        }

        current.push(tag);
        input.value = current.join(", ");

        // Tạo tag hiển thị
        const tagEl = document.createElement("span");
        tagEl.className = "badge bg-danger text-white d-flex align-items-center gap-2 px-3 py-2";
        tagEl.innerHTML = `${tag} <i class="bi bi-x-circle-fill" style="cursor:pointer;"></i>`;

        // Xử lý nút xoá
        tagEl.querySelector("i").onclick = () => {
            tagEl.remove();

            // 🔁 Đọc lại input.value để đảm bảo đồng bộ
            let tagsNow = input.value.split(',').map(t => t.trim()).filter(t => t);
            tagsNow = tagsNow.filter(t => t !== tag);

            input.value = tagsNow.join(", ");
        };

        selectedContainer.appendChild(tagEl);
    }
</script>
<script>
    // Ngăn không cho nhập chữ trong ô số
    function validateNumberInput(input) {
        input.value = input.value.replace(/[^0-9]/g, ''); // Chỉ giữ số
    }

    document.getElementById("foodForm").addEventListener("submit", function (e) {
        let isValid = true;
        const prepTimeInput = document.getElementById("foodPrepTime");
        const prepTimeError = document.getElementById("foodPrepTimeError");

        prepTimeError.textContent = ""; // reset lỗi cũ

        // Kiểm tra thời gian chế biến > 0
        const prepTime = parseInt(prepTimeInput.value);
        if (isNaN(prepTime) || prepTime <= 0) {
            prepTimeError.textContent = "Thời gian chế biến phải lớn hơn 0.";
            isValid = false;
        }

        if (!isValid) {
            e.preventDefault(); // chặn submit nếu có lỗi
        }
    });
</script>