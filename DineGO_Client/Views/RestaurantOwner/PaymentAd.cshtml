@model Core.Models.Client.Custom.AdRegistrationRequestDto
@{
    ViewData["Title"] = "Thanh toán quảng cáo";
    var addInfo = $"AdToken {ViewBag.Token}";
}

<div class="container mt-5" style="max-width: 900px;">
    <div class="alert alert-info">
        ✅ Quảng cáo đã được đăng ký. Vui lòng thanh toán trong 10 phút để kích hoạt.
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="border p-3 rounded bg-white">
                <h5 class="fw-bold">Thanh toán quảng cáo</h5>
                <p>Slot: @Model.slot_id</p>
                <p>Bắt đầu: @Model.start_date.ToString("dd/MM/yyyy")</p>
                <p>Kết thúc: @Model.end_date.ToString("dd/MM/yyyy")</p>
                <p>Số tiền: <span class="fw-bold text-danger">@ViewBag.TotalPrice.ToString("N0") VND</span></p>
                <p>Thời gian thanh toán: <span id="countdown" class="text-danger fw-bold">--:--</span></p>

                <div class="text-center my-3">
                    <img src="https://img.vietqr.io/image/ACB-20051417-compact2.png?amount=@ViewBag.TotalPrice&addInfo=@addInfo&accountName=DINOGO"
                        class="img-fluid" alt="QR Code Thanh Toán">
                </div>
                <div id="expiredMessage" class="alert alert-danger text-center mt-3 d-none">
                    ⏰ Hết thời gian thanh toán. Vui lòng đăng ký lại!
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        let countdown = 600; // 10 phút
        const countdownEl = document.getElementById("countdown");

        function updateCountdown() {
            const mins = Math.floor(countdown / 60);
            const secs = countdown % 60;
            countdownEl.textContent = `${mins}:${secs.toString().padStart(2, "0")}`;

            if (countdown <= 0) {
                clearInterval(timer);
                clearInterval(checker);
                document.getElementById("expiredMessage").classList.remove("d-none");
                fetch(`/RestaurantOwner/CancelIfExpiredAd`, { method: "PUT" });
                return;
            }
            countdown--;
        }

        async function checkPaid() {
            try {
                console.log("🔄 Gọi /RestaurantOwner/CheckPaidAd...");
                const res = await fetch(`/RestaurantOwner/CheckPaidAd`);
                const data = await res.json();
                console.log("👉 Kết quả CheckPaidAd:", data);

                if (data.success) {
                    clearInterval(timer);
                    clearInterval(checker);
                    alert(data.message);
                    setTimeout(() => {
                        window.location.href = "/RestaurantOwner/restaurantowner/ActiveAds";
                    }, 3000);
                }
            } catch (err) {
                console.error("❌ Lỗi khi gọi CheckPaidAd:", err);
            }
        }

        const timer = setInterval(updateCountdown, 1000);
        const checker = setInterval(checkPaid, 31000); // giống reservation (31 giây)
    });
</script>