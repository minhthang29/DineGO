@model Core.Models.Client.Custom.CustomProfileViewModel
@{
    Layout = "../../Views/Shared/_Profile.cshtml";
    ViewData["Title"] = Model.ChangePasswordModel.HasPassword ? "Đổi Mật Khẩu" : "Tạo Mật Khẩu";
}

<!-- Profile Content (Chiếm 8 cột) -->
<div class="col-md-9 d-flex justify-content-center">
    <div class="profile-container_form">
        <h3 class="text-center mb-4">
            @if (Model.ChangePasswordModel.HasPassword)
            {
                <span>Đổi mật khẩu</span>
            }
            else
            {
                <span>Tạo mật khẩu</span>
            }
        </h3>

        @if (!Model.ChangePasswordModel.HasPassword)
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle"></i>
                Tài khoản của bạn chưa có mật khẩu. Vui lòng tạo mật khẩu để bảo mật tài khoản.
            </div>
        }

        <!-- Hiển thị thông báo lỗi hoặc thành công -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger text-center">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <!-- Form Đổi/Tạo Mật Khẩu -->
        <form asp-action="ChangePassword" method="post">
            
            @if (Model.ChangePasswordModel.HasPassword)
            {
                <!-- Chỉ hiển thị mật khẩu hiện tại nếu customer đã có mật khẩu -->
                <div class="form-group mb-3">
                    <label for="CurrentPassword" class="font-weight-bold">Mật khẩu hiện tại *</label>
                    <div class="input-group">
                        <input asp-for="ChangePasswordModel.CurrentPassword" type="password" class="form-control form-control-lg" 
                            placeholder="Nhập mật khẩu hiện tại" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ChangePasswordModel_CurrentPassword')">
                                <i class="fas fa-eye" id="ChangePasswordModel_CurrentPassword-icon"></i>
                            </button>
                        </div>
                    </div>
                    <span asp-validation-for="ChangePasswordModel.CurrentPassword" class="text-danger"></span>
                </div>
            }

            <div class="form-group mb-3">
                <label for="NewPassword" class="font-weight-bold">
                    @if (Model.ChangePasswordModel.HasPassword)
                    {
                        <span>Mật khẩu mới *</span>
                    }
                    else
                    {
                        <span>Mật khẩu *</span>
                    }
                </label>
                <div class="input-group">
                    <input asp-for="ChangePasswordModel.NewPassword" type="password" class="form-control form-control-lg" 
                        placeholder="@(Model.ChangePasswordModel.HasPassword ? "Nhập mật khẩu mới" : "Nhập mật khẩu")" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ChangePasswordModel_NewPassword')">
                            <i class="fas fa-eye" id="ChangePasswordModel_NewPassword-icon"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="ConfirmNewPassword" class="font-weight-bold">Xác nhận mật khẩu *</label>
                <div class="input-group">
                    <input asp-for="ChangePasswordModel.ConfirmNewPassword" type="password" class="form-control form-control-lg" 
                        placeholder="@(Model.ChangePasswordModel.HasPassword ? "Nhập lại mật khẩu mới" : "Nhập lại mật khẩu")" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ChangePasswordModel_ConfirmNewPassword')">
                            <i class="fas fa-eye" id="ChangePasswordModel_ConfirmNewPassword-icon"></i>
                        </button>
                    </div>
                </div>
                <span asp-validation-for="ChangePasswordModel.ConfirmNewPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-danger btn-lg w-100 mt-3">
                @if (Model.ChangePasswordModel.HasPassword)
                {
                    <span>Đổi mật khẩu</span>
                }
                else
                {
                    <span>Tạo mật khẩu</span>
                }
            </button>
        </form>
    </div>
</div>

<script>
function togglePassword(fieldId) {
    const field = document.getElementById(fieldId);
    const icon = document.getElementById(fieldId + '-icon');
    
    if (field.type === 'password') {
        field.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
    } else {
        field.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
    }
}
</script>