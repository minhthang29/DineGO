<div id="video-call-popup" class="video-call-popup d-none">
    <div class="video-call-header">
        <span>🎥 Cuộc gọi video</span>
        <button id="close-video-btn" class="btn btn-sm btn-danger">×</button>
    </div>
    <div id="call-status-msg" class="popup d-none"></div>
    <div id="incoming-popup" class="popup d-none">
        📞 Cuộc gọi đến từ <b><span id="caller-name">Người gọi</span></b><br />
        <button id="accept-call-btn" class="btn btn-success btn-sm mt-2">✔️ Chấp nhận</button>
        <button id="reject-call-btn" class="btn btn-danger btn-sm mt-2">❌ Từ chối</button>
    </div>
    <div class="video-call-body">
        <video id="remoteVideo" autoplay playsinline></video>
        <video id="localVideo" autoplay playsinline muted></video>
    </div>
    <div class="text-center mt-2">
        <button id="toggle-cam-btn" class="btn btn-warning">🎥 Bật/Tắt Camera</button>
        <button id="end-call-btn" class="btn btn-danger">📴 Kết thúc cuộc gọi</button>
    </div>
</div>
