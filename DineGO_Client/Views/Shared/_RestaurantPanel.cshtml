<!DOCTYPE html>
<html lang="en">
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var res_id = HttpContextAccessor.HttpContext?.Session.GetInt32("res_id");
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DineGO_Client</title>
    <link rel="icon" type="image/png" href="/common/images/favicon.ico" />
    <link rel="stylesheet" href="/common/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/common/lib/slider/owl.carousel.min.css" />
    <link rel="stylesheet" href="/common/lib/slider/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/common/css/popup.css" />
    <link rel="stylesheet" href="/client/css/site.css" />
    <link rel="stylesheet" href="/common/css/add_image.css" />
    <link rel="stylesheet" href="/common/css/loading.css" />
    <link rel="stylesheet" href="/common/css/notification.css" />
    <link rel="stylesheet" href="/client/css/table.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>

<body>

    <header>
        @Html.Partial("_Header")
    </header>
    @*Common notification*@
    @await Html.PartialAsync("_Notification")
    <main role="main" class="pb-3">
        <div class="container mt-5">
            <div class="row container-profile align-items-start">
                <div class="col-md-3">
                    <div class="sidebar">
                        @if (ViewBag.Restaurant != null &&
                                                ViewBag.Restaurant.res_images_json != null &&
                                                ViewBag.Restaurant.res_images_json.Count > 0)
                        {
                            <div class="profile-info">
                                <div class="profile-avatar">
                                    <img src="https://dinego-bucket-aws.s3.ap-south-1.amazonaws.com/restaurants/thumb_@ViewBag.Restaurant.res_images_json[0]" class="rounded-circle border shadow-sm"
                                        alt="Ảnh đại diện nhà hàng" />
                                </div>
                                <h3 class="profile-username">@ViewBag.Restaurant?.res_name</h3>
                            </div>
                        }
                        else
                        {
                            <div class="profile-info">
                                <div class="profile-avatar">
                                    <img src="/client/images/logo.jpg" class="rounded-circle border shadow-sm"
                                        alt="Ảnh đại diện mặc định" />
                                </div>
                                <h3 class="profile-username">@ViewBag.Restaurant?.res_name</h3>
                            </div>
                        }

                        <hr>

                        <div class="menu-item @(currentAction == "ListMenu" ? "active" : "")"
                            onclick="location.href='@Url.Action("ListMenu", "Menu", new { res_id = res_id })'">
                            Quản lí menu
                        </div>

                        <!-- Nhóm Đặt bàn -->
                        <div class="menu-item" onclick="toggleSubMenu('bookingSubMenu')">Đặt bàn ▸</div>

                        <div id="bookingSubMenu" class="submenu"
                            style="display:@((currentAction == "ViewTableStatus" || currentAction == "ReservationHistory") ? "block" : "none")">
                            <div class="menu-item @(currentAction == "ViewTableStatus" ? "active" : "")"
                                onclick="location.href='@Url.Action("ViewTableStatus", "Table")'">Danh sách đặt bàn
                            </div>
                            <div class="menu-item @(currentAction == "ReservationHistory" ? "active" : "")"
                                onclick="location.href='@Url.Action("ReservationHistory", "Table")'"> Lịch sử đặt bàn
                            </div>
                        </div>

                        <!-- Nhóm Đặt món -->
                        <div class="menu-item" onclick="toggleSubMenu('orderSubMenu')">Đặt món ▸</div>

                        <div id="orderSubMenu" class="submenu"
                            style="display:@((currentAction == "Index"  && currentController == "Order") ? "block" : "none")">
                            <div class="menu-item @(currentAction == "Index" && currentController == "Order" ? "active" : "")" onclick="location.href='@Url.Action("Index", "Order")'">Danh sách đặt món</div>
                        </div>

                        <!-- Nhóm Thiết lập -->
                        <div class="menu-item" onclick="toggleSubMenu('settingProfile')">Thiết lập nhà hàng ▸</div>

                        <div id="settingProfile" class="submenu"
                            style="display:@((currentAction == "ProfileRestaurant" || currentAction == "ViewArea" || (currentAction == "Index" && currentController == "Table")) ? "block" : "none")">
                            <div class="menu-item @(currentAction == "ProfileRestaurant" ? "active" : "")"
                                onclick="location.href='@Url.Action("ProfileRestaurant", "RestaurantOwner", new { res_id = res_id })'">Thông tin
                                nhà hàng</div>
                            <div class="menu-item @(currentAction == "ViewArea" ? "active" : "")"
                                onclick="location.href='@Url.Action("ViewArea", "Table")'">Quản lý khu vực</div>
                            <div class="menu-item @((currentAction == "Index" && currentController == "Table" ) ? "active" : "")"
                                onclick="location.href='@Url.Action("Index", "Table")'">Quản lý bàn</div>
                        </div>
                          <div class="menu-item @(currentAction == "ListRestaurant" ? "active" : "")"
                            onclick="location.href='@Url.Action("ListRestaurant", "RestaurantOwner")'">Quay về chủ nhà hàng
                        </div>
                    </div>
                </div>

                <div class="col-md-9">
                    @RenderBody()
                </div>
            </div>
        </div>
    </main>

    @* Loading *@
    <div id="global-overlay" class="d-none">
        <div id="global-loader">
            <div id="loading-text">
                <span class="loading-word">Loading</span>
                 <span class="dot">.</span><span class="dot">.</span><span class="dot">.</span> <!-- Dấu chấm sẽ animate nhảy trái-phải -->
            </div>
        </div>
    </div>

    <footer>
        @Html.Partial("_Footer")
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="/common/lib/jquery/jquery-3.6.0.min.js"></script>
    <script src="/common/js/popup.js"></script>
    <script src="/client/js/table.js"></script>
    <script src="/common/js/notification.js"></script>
    <script src="/common/lib/bootstrap/bootstrap.min.js"></script>
    <script src="/common/lib/slider/owl.carousel.min.js"></script>
    <script src="/common/js/add_image.js"></script>
    <script src="/client/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
