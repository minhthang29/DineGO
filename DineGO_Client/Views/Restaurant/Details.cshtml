<!-- Thêm FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="/client/js/imagePreview.js" asp-append-version="true"></script>
<script>
document.addEventListener("click", async function (e) {
    const btn = e.target.closest(".btn-add-cart");
    if (!btn) return;

    // ⛔ Ngăn click lan ra thẻ <a>
    e.preventDefault();
    e.stopPropagation();

    const foodId = btn.dataset.foodId;
    const quantity = parseInt(btn.dataset.quantity || "1", 10);

    try {
        const response = await fetch("/Cart/AddJson", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-Requested-With": "XMLHttpRequest"
            },
            body: JSON.stringify({ foodId, quantity })
        });

        const result = await response.json();

        if (response.ok && result.success) {
            showNotification("Đã thêm món vào giỏ hàng!", "success");
        } else {
            showNotification(result.message || "❌ Không thể thêm vào giỏ!, bạn cần đăng nhập trước khi thêm món vào giỏ!", "danger");
        }
    } catch (err) {
        showNotification("❌ Lỗi: " + err.message, "danger");
    }
});

function showNotification(message, type = "success") {
    const container = document.getElementById("notification-container") 
                      || (() => {
                          const div = document.createElement("div");
                          div.id = "notification-container";
                          div.className = "position-fixed top-0 end-0 m-3";
                          div.style.zIndex = 1060;
                          document.body.appendChild(div);
                          return div;
                      })();

    container.innerHTML = "";

    const div = document.createElement("div");
    div.className = `alert alert-${type} d-flex align-items-center shadow-sm border-0 rounded-3`;
    div.role = "alert";

    let iconHtml = "";
    if (type === "success") {
        iconHtml = `<i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>`;
    } else if (type === "danger") {
        iconHtml = `<i class="bi bi-x-circle-fill me-2 fs-5 text-danger"></i>`;
    }

    div.innerHTML = `${iconHtml}<div>${message}</div>`;
    container.appendChild(div);

    setTimeout(() => {
        div.classList.add("fade");
        div.addEventListener("transitionend", () => div.remove());
    }, 3000);
}

</script>

<!-- Script để cập nhật giá trị ngày & giờ -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // ⏰ Cập nhật ngày và giờ hiện tại
        let now = new Date();
        let today = now.toISOString().split("T")[0];
        const dateInput = document.getElementById("dateInput");
        const timeInput = document.getElementById("timeInput");
        if (dateInput) dateInput.value = today;
        if (timeInput) {
            let hours = now.getHours().toString().padStart(2, '0');
            let minutes = now.getMinutes().toString().padStart(2, '0');
            timeInput.value = `${hours}:${minutes}`;
        }

        // ⭐ Xử lý đánh giá sao
        document.querySelectorAll(".star-rating").forEach(starGroup => {
            const stars = starGroup.querySelectorAll(".star-icon");
            const hiddenInput = starGroup.parentElement.querySelector("input[name='rating_value']");
            const currentValue = parseInt(starGroup.getAttribute("data-selected") || "0");

            stars.forEach((s, i) => s.classList.toggle("filled", i < currentValue));
            hiddenInput.value = currentValue;

            stars.forEach((star, index) => {
                star.addEventListener("mouseenter", () => {
                    for (let i = 0; i <= index; i++) stars[i].classList.add("filled");
                    for (let i = index + 1; i < stars.length; i++) stars[i].classList.remove("filled");
                });

                star.addEventListener("mouseleave", () => {
                    const selectedValue = parseInt(hiddenInput.value || "0");
                    stars.forEach((s, i) => s.classList.toggle("filled", i < selectedValue));
                });

                star.addEventListener("click", () => {
                    const value = parseInt(star.getAttribute("data-value"));
                    hiddenInput.value = value;
                    stars.forEach((s, i) => s.classList.toggle("filled", i < value));
                });
            });
        });

        // ✅ Theo dõi / bỏ theo dõi
        const followBtn = document.getElementById("follow-btn");
        const followText = document.getElementById("follow-text");
        const resId = @Model.Restaurant.res_id;

        if (followBtn) {
            async function checkFollowStatus() {
                try {
                    const res = await fetch(`/Restaurant/CheckFollow?res_id=${resId}`);
                    const data = await res.json();
                    updateFollowUI(data.isFollowing);
                } catch (error) {
                    console.error("Lỗi khi kiểm tra theo dõi:", error);
                }
            }

            function updateFollowUI(isFollowing) {
                if (isFollowing) {
                    followBtn.classList.remove("btn-outline-danger");
                    followBtn.classList.add("btn-outline-secondary");
                    followText.textContent = "Đã theo dõi";
                } else {
                    followBtn.classList.remove("btn-outline-secondary");
                    followBtn.classList.add("btn-outline-danger");
                    followText.textContent = "Theo dõi";
                }
            }

            followBtn.addEventListener("click", async () => {
                const isFollowed = followText.textContent === "Đã theo dõi";
                const url = isFollowed
                    ? `/Restaurant/Unfollow?res_id=${resId}`
                    : `/Restaurant/Follow?res_id=${resId}`;

                try {
                    const res = await fetch(url, { method: "POST" });
                    const data = await res.json();
                    if (data.success !== undefined) {
                        updateFollowUI(!isFollowed);
                    } else {
                        alert("Lỗi khi xử lý theo dõi.");
                    }
                } catch (error) {
                    console.error("Lỗi khi gửi yêu cầu theo dõi:", error);
                }
            });

            checkFollowStatus(); // Gọi khi load
        }

        // ⏳ Tự đóng alert sau 4 giây
        setTimeout(() => {
            const alert = document.querySelector('.alert-dismissible');
            if (alert) new bootstrap.Alert(alert).close();
        }, 4000);
    });

    // 📝 Toggle form chỉnh sửa đánh giá
    function toggleEditRating() {
        const form = document.getElementById("editRatingForm");
        form.classList.toggle("d-none");
        form.scrollIntoView({ behavior: "smooth" });
    }
</script>

